#!/usr/bin/env bash
# Turn a batch of .ttrm replays into a verified session.
#
#   bin/new-session sessions/2026-08-01 ~/Downloads/replay-batch
#   MUTATION=1 bin/new-session sessions/2026-08-01 ~/Downloads/replay-batch
#
# Runs the whole chain, stopping at the first failed gate:
#
#   1. copy the replays in
#   2. both independent extractors -> facts.json / facts2.json, which must agree
#   3. generate the claim ledger; every predicate must evaluate True
#   4. generate Dafny from the same specs; `dafny verify` must report 0 errors
#   5. (MUTATION=1) flipping a datum must break verification
#   6. the simulator emitters -> sim/*.json (quarantined: no claim ids, no badges):
#      the five that need only bun and pc-miss (its Rust solver builds on first use), in
#      parallel, and cspin-miss when a cold-clear coach binary exists: CC_COACH, or else the
#      one bin/build-cc-coach caches; without either a loud !! line says how to build it
#   7. emit a report skeleton — but only if the session has no report.html yet
#
# What it does NOT do is write the Cantonese prose — that is the part that needs
# judgment. It leaves you a verified ledger, a report shell with every generated
# region already in place, and TODO prose files to write into.
#
# Step 6 runs before the skeleton because every quarantined section (forecast, openers,
# attack-sources, round-replay) is SELF_INSERTING: build_report gives a session the section
# only when its sim/*.json is on disk. Emitted after the skeleton, those sections would be
# missing from a fresh report while the artefacts sat beside it — and check_attack_section
# and its siblings fail exactly that state.
#
# Step 7 never touches a report that exists. A committed report.html is the output
# of this pipeline plus a person's writing, and re-running the command on a session
# that already has one must not cost that writing.
set -euo pipefail

DEST="${1:?usage: bin/new-session <sessions/DATE> <replay-dir>}"
SRC="${2:?usage: bin/new-session <sessions/DATE> <replay-dir>}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

step() { printf '\n== %s\n' "$*"; }
die()  { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

command -v jq >/dev/null    || die "jq not installed"
command -v dafny >/dev/null || die "dafny not installed"

shopt -s nullglob
REPLAYS=("$SRC"/*.ttrm)
[ "${#REPLAYS[@]}" -gt 0 ] || die "no .ttrm files in $SRC"

WORK="$DEST/report"
step "1/7 collecting ${#REPLAYS[@]} replays into $DEST"
mkdir -p "$WORK"
for f in "${REPLAYS[@]}"; do
  dst="$DEST/$(basename "$f")"
  # Test for the file rather than trusting `cp -n`: BSD/macOS cp exits 1 when -n
  # makes it skip, and `set -e` turned that into an abort at step 1 — so the
  # command could never be re-run over a session whose replays were already in
  # place, which is exactly the run that must reach step 7 and leave report.html
  # alone.
  [ -e "$dst" ] || cp "$f" "$dst"
done
# the extractors read ../*.ttrm relative to the report dir, so they are copied in.
# check_claims.py is NOT: it is one shared module now (`python3 -m pipeline.check_claims`,
# which is what bin/verify-session runs), and copying it per session is how there came to
# be eight byte-identical copies of the repo's primary claim gate.
cp pipeline/extract.py pipeline/extract2.ts "$WORK/" 2>/dev/null || true
ls "$DEST"/*.ttrm >/dev/null || die "no replays landed in $DEST"

step "2/7 extracting twice and comparing"
( cd "$WORK" && python3 extract.py >/dev/null )
if command -v bun >/dev/null; then
  ( cd "$WORK" && bun extract2.ts >/dev/null )
  diff <(jq -S . "$WORK/facts.json") <(jq -S . "$WORK/facts2.json") >/dev/null \
    || die "the two extractors disagree — resolve before trusting anything downstream"
  echo "  ok  independent extractors agree"
else
  echo "  !!  bun not installed: only the Python extractor ran, so the"
  echo "      two-parser agreement gate did NOT run for this session"
fi

step "3/7 generating the claim ledger"
python3 -m pipeline.claims.build_claims "$WORK/facts.json" \
  --out "$WORK/claims-generated.json" || die "claim generation refused to emit"

step "4/7 generating and verifying Dafny"
# Only for a session with no hand claims yet. Once hand_claims*.py exists, the committed
# dafny/ and claims-proof-map.json cover every ledger, and regenerating them from the
# generated ledger alone would silently drop the hand lemmas and their badges' links.
HAND=("$WORK"/hand_claims*.py)
if [ "${#HAND[@]}" -gt 0 ]; then
  echo "  --  ${#HAND[@]} hand_claims*.py in $WORK: dafny/ and claims-proof-map.json left"
  echo "      untouched (they cover the hand ledgers too). bin/verify-session checks them"
else
  python3 -m pipeline.codegen "$WORK/facts.json" \
    --claims "$WORK/claims-generated.json" --outdir "$WORK/dafny"
  VOUT="$(cd "$WORK" && dafny verify dafny/Facts.dfy dafny/Claims.dfy --cores 4 2>&1 | tail -1)"
  case "$VOUT" in
    *"0 errors"*) echo "  ok  $VOUT" ;;
    *) die "dafny — $VOUT" ;;
  esac
  python3 -m pipeline.build_proof_map "$WORK/claims-generated.json" \
    --dafny-dir "$WORK/dafny" --out "$WORK/claims-proof-map.json"
fi

if [ "${MUTATION:-0}" = "1" ]; then
  step "5/7 mutation testing the generated proofs"
  bash pipeline/mutation_test.sh "$WORK/dafny" 12 || die "a mutant survived — some lemma is vacuous"
else
  step "5/7 mutation test skipped (set MUTATION=1 to run it)"
fi

step "6/7 simulator artefacts"
# Each emitter is deterministic — every committed sim/*.json rebuilds byte for byte — so
# re-running over a session that has them is safe, and the line says whether one moved.
# They read the replays from REPLAY_DIR, i.e. $DEST, where step 1 copied them, and each
# writes only its own file, so they run at once: the five that need only bun, pc-miss
# once replay-facts.json is written (it reads it), and the cspin-miss chain (it reads only
# the replays) beside all of them. The lines print in a fixed order whatever finishes first.
if command -v bun >/dev/null; then
  mkdir -p "$DEST/sim"
  LOGS="$(mktemp -d)"
  trap 'rm -rf "$LOGS"' EXIT
  sum_of() { if [ -f "$1" ]; then shasum "$1"; fi; }
  # emit <name> <command...>: run it with REPLAY_DIR=$DEST, stdout dropped, stderr to <name>.err,
  # after writing <name>.before (the old file's sum), so the state is judged against the old bytes
  emit() {
    local name="$1"; shift
    sum_of "$DEST/sim/$name.json" > "$LOGS/$name.before"
    REPLAY_DIR="$DEST" "$@" >/dev/null 2>"$LOGS/$name.err"
  }
  report() {   # report <name> <pid> <what failed>
    local name="$1" out="$DEST/sim/$1.json" before state
    if ! wait "$2"; then cat "$LOGS/$name.err" >&2; die "$3"; fi
    before="$(cat "$LOGS/$name.before")"
    if [ -z "$before" ]; then state=new
    elif [ "$before" = "$(sum_of "$out")" ]; then state=unchanged
    else state=CHANGED; fi
    echo "  ok  $out ($state)"
  }

  # cspin-miss needs cold-clear itself: the windows go through the coach binary and its
  # placements come back into the artefact. CC_COACH names the binary; unset, it defaults to
  # the one bin/build-cc-coach caches (the pinned rev plus tools/cc-coach's patch, harness and
  # lock) once that has been built. Without either it says so loudly, because a session
  # without the artefact gets no C-Spin 冇砌 section and nothing else would mention it.
  if [ -z "${CC_COACH:-}" ] && built="$(bin/build-cc-coach --path)"; then
    CC_COACH="$built"
    echo "  --  CC_COACH unset: using the bin/build-cc-coach cache, $CC_COACH"
  fi
  CSPIN=""
  if [ -n "${CC_COACH:-}" ]; then
    [ -x "$CC_COACH" ] || die "CC_COACH=$CC_COACH is not an executable"
    ccdir="$(mktemp -d)"
    cspin_chain() {
      bun pipeline/sim/cspin-miss.ts --windows "$ccdir/in.jsonl" \
        || { echo "cspin-miss.ts --windows failed" >&2; return 1; }
      CC_NODES=40000 COACH_MODE=rollout "$CC_COACH" < "$ccdir/in.jsonl" > "$ccdir/out.jsonl" \
        || { echo "the cold-clear coach ($CC_COACH) failed" >&2; return 1; }
      bun pipeline/sim/cspin-miss.ts --cc "$ccdir/out.jsonl" --out "$DEST/sim/cspin-miss-facts.json" \
        || { echo "cspin-miss.ts --cc failed" >&2; return 1; }
    }
    emit cspin-miss-facts cspin_chain &
    CSPIN=$!
  fi

  declare -A PID
  for pair in forecast-facts:emit-forecast-facts opener-facts:emit-opener-facts \
              attack-facts:emit-attack-facts finesse-facts:emit-finesse-facts \
              replay-facts:emit-replay; do
    emit "${pair%%:*}" bun "pipeline/sim/${pair##*:}.ts" --out "$DEST/sim/${pair%%:*}.json" &
    PID[${pair%%:*}]=$!
  done
  # pc-miss reads sim/replay-facts.json, so it starts once that is written. Its PC solver is
  # the Rust crate pipeline/sim/pc-solver-rs, which pc-solver-native.ts builds when stale, so
  # cargo has to be on PATH the first time. Its one progress line per round goes to stderr,
  # kept out of the way unless it fails.
  report replay-facts "${PID[replay-facts]}" "emit-replay.ts failed — see the error above"
  emit pc-miss-facts bun pipeline/sim/pc-miss.ts --out "$DEST/sim/pc-miss-facts.json" &
  PCMISS=$!
  for pair in forecast-facts:emit-forecast-facts opener-facts:emit-opener-facts \
              attack-facts:emit-attack-facts finesse-facts:emit-finesse-facts; do
    report "${pair%%:*}" "${PID[${pair%%:*}]}" "${pair##*:}.ts failed — see the error above"
  done
  report pc-miss-facts "$PCMISS" "pc-miss.ts failed — see the error above (it needs cargo to build pc-solver-rs)"

  out="$DEST/sim/cspin-miss-facts.json"
  if [ -n "$CSPIN" ]; then
    report cspin-miss-facts "$CSPIN" "the cspin-miss chain failed — see the error above"
    rm -rf "$ccdir"
  elif [ -f "$out" ]; then
    echo "  --  CC_COACH unset and bin/build-cc-coach not built: $out left as it is (not re-derived)"
  else
    echo "  !!  CC_COACH unset: NO $out, so the report gets no C-Spin 冇砌 section."
    echo "  !!  Build the coach once per machine (about a minute; needs cargo and network):"
    echo "  !!    bin/build-cc-coach"
    echo "  !!  and re-run this command, which then finds it; or set CC_COACH=<a cc-coach binary>;"
    echo "  !!  or run by hand:"
    echo "  !!    REPLAY_DIR=$DEST bun pipeline/sim/cspin-miss.ts --windows /tmp/cc-in.jsonl"
    echo "  !!    CC_NODES=40000 COACH_MODE=rollout <cc-coach> < /tmp/cc-in.jsonl > /tmp/cc-out.jsonl"
    echo "  !!    REPLAY_DIR=$DEST bun pipeline/sim/cspin-miss.ts --cc /tmp/cc-out.jsonl --out $out"
  fi
else
  echo "  !!  bun not installed: no sim/*.json, so the report gets none of the seven"
  echo "      quarantined sections (forecast, openers, attack-sources, finesse-placements,"
  echo "      round-replay, pc-miss, cspin-miss)"
fi

step "7/7 report skeleton"
# Only when there is none. A report that exists carries a person's Cantonese, and
# the skeleton would replace every generated region with an empty one.
if [ -f "$WORK/report.html" ]; then
  echo "  ok  $WORK/report.html exists — left untouched"
else
  python3 -m pipeline.skeleton "$WORK" || die "could not emit the report skeleton"
  python3 -m pipeline.build_report "$WORK" >/dev/null \
    || die "the skeleton's regions did not fill — see the error above"
  python3 -m pipeline.build_round_table "$WORK" >/dev/null \
    || die "the round table did not fill"
  # Again, so the tier nav (pipeline/report_order.py) links to the round table it now holds.
  python3 -m pipeline.build_report "$WORK" >/dev/null \
    || die "the report did not re-render after the round table"
  echo "  ok  $WORK/report.html built from the skeleton with TODO prose"
fi

DATE="$(basename "$DEST")"
CLAIMS=$(jq length "$WORK/claims-generated.json")
ROUNDS=$(jq '[.matches[].rounds | length] | add' "$WORK/facts.json")
cat <<EOF

verified: $CLAIMS generated claims over $ROUNDS rounds in $WORK

next, the parts that need judgment. Every one of them is a file that now exists
and says TODO — the report renders before a word is written, so the writing can be
checked in a browser as it goes:
  1. write $WORK/narrative-beats.md and $WORK/recommendations.md against the
     generated ledger (each countable statement citing its claim id), then fill in
     the TODO prose files (the date, names, scores and every figure come from
     facts.json — prose is words only):
       $WORK/prose/hero.json      headline, both taglines, lede
       $WORK/prose/matches.json   戰況's heading/lede/closer + one card per match
       $WORK/prose/moments.json   關鍵時刻's cards and trivia
       $WORK/prose/stats.json     數據對決's lede, panel headings and captions
       $WORK/prose/coaching.json  both columns' taglines, profiles, recommendations
     and the one thing no generator owns, edited in report.html itself:
       the <title> — everything else in the body is generated
  2. add hand-written claims for whatever is genuinely unique to this session in
     $WORK/hand_claims.py, then fold them into the proofs over EVERY ledger (step 4
     skips a session once hand claims exist, so re-running this command will not):
       python3 -m pipeline.claims.build_hand $WORK/hand_claims.py \\
         --facts $WORK/facts.json --out $WORK/claims-narrative.json
       python3 -m pipeline.codegen $WORK/facts.json --outdir $WORK/dafny \\
         --claims $WORK/claims-generated.json $WORK/claims-narrative.json
       (cd $WORK && dafny verify dafny/Facts.dfy dafny/Claims.dfy --cores 4)
       python3 -m pipeline.build_proof_map --dafny-dir $WORK/dafny --out $WORK/claims-proof-map.json \\
         $WORK/claims-generated.json $WORK/claims-narrative.json
       python3 -m pipeline.codegen_smt $WORK/facts.json --out $WORK/claims.smt2 \\
         --claims $WORK/claims-generated.json $WORK/claims-narrative.json
     bin/fold-hand-claims $DATE runs that fold (one Dafny pass) and refreshes the
     session's equiv-coverage figures, where the tool is on this branch.
  3. add the date to the session lists the sim tests pin — each one is asserted
     against disk, so a miss is a red test rather than a silent skip. The typing is
     mechanical and bin/add-session-dates does it (every bare full-corpus date list,
     nothing else); the per-session literals beside them are measurements and are not:
       bin/add-session-dates $DATE
     then investigate any new anchor disagreement before naming it in an exception list:
       bun test pipeline/sim/ pipeline/openers/ pipeline/finesse-counters.test.ts
     and re-emit the corpus artefacts the new session moves (about a minute: the route
     and technique facts share two digests), then paste the figures the docs quote:
       bin/emit-corpus
       bin/paste-fragments
  4. rebuild the report after every prose edit (and after step 6 reports CHANGED on a
     session whose report.html already existed), then refresh the site:
       python3 -m pipeline.build_report $WORK
       python3 -m pipeline.build_round_table $WORK
       python3 -m pipeline.check_prose_figures $WORK
       python3 -m pipeline.check_badge_links $WORK
       python3 bin/build-docs
     (bin/build-docs refuses a session with no row in its ARTEFACTS table: add one, with the
     index card's one-line Cantonese blurb, newest last — the index lists it first)
     bin/session-loop $DATE runs that loop (report, round table, report again, the
     per-session gates CI runs, the TODO scan and a preview), where it is on this branch.
  5. list what the corpus-wide gates still need for this session (read-only, seconds):
       bin/session-todo $DEST
EOF
