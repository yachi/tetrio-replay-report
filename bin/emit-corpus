#!/usr/bin/env python3
"""Re-emit every corpus-wide artefact under analysis/, in dependency order, in parallel.

    bin/emit-corpus                  re-emit every artefact that reads the sessions (the corpus tier)
    bin/emit-corpus --all            also the constructed artefacts no session feeds (demos, own designs,
                                     orders, the self-play rebuild)
    bin/emit-corpus --check          emit into a temp dir and cmp against the committed files; write
                                     nothing; exit 1 on any difference
    bin/emit-corpus --only <name>    one artefact (repeatable; its dependencies are NOT re-run, they are
                                     read from analysis/ as committed)
    bin/emit-corpus --jobs N         run up to N emitters at once (default: nproc)
    bin/emit-corpus --list           print the plan (tiers, edges, skips) and exit
    bin/emit-corpus --unbatched      run each node's own entry file (the route facts, technique facts, DPC and
                                     Second PC facts otherwise share digests in emit-corpus-batch.ts)

WHY THIS EXISTS.  The ~24 corpus emitters that write analysis/*.json were run one by one by hand, in an
order written down only in prose (CLAUDE.md: route facts before 基本的なドネイト's facts, which hash the
route artefacts; facts before demos).  A session landing moves every one of them, and a missed one is
not loud until its test goes red in CI.

THE LIST IS DERIVED, NOT COPIED.  Openers, techniques, their demos and own designs come from the
registries the emitters themselves read (`route-openers.ts` OPENERS, `techniques.ts` TECHNIQUES /
TECHNIQUE_DEMOS / TECHNIQUE_OWN), asked through bun.  The handful of single-purpose emitters (DPC, Second
PC, forecast events, the SDPC loop demos, the orders, the self-play rebuild) are listed in EXTRA below.
Then every analysis/*.json must be produced by exactly one node, or named in EXCLUDED with a reason; an
artefact on disk nobody accounts for is an error, so a new emitter cannot be silently left out.

THE EDGES ARE DERIVED TOO.  A node's DATA inputs are every analysis/*.json its profile hashes (a technique
profile's `hashFiles`) or reads (`crossRoute.artefact`), plus EXTRA's own `reads`.  A node is in the
CORPUS tier when it reads the sessions itself or has a data edge to a corpus node — so
basicdonating-demos is corpus-tier (its classifier hash covers the route facts) while the other demos
are not.  ORDER edges (demos after their own facts, as CLAUDE.md asks) only sequence; they do not move a
node between tiers.

TWENTY-TWO NODES SHARE TWO DIGESTS.  Every route-facts node rebuilds one route digest, and every
technique-facts node, the DPC and the Second PC facts one technique digest, none of which depends on the
opener or technique.  So those nodes run as two `pipeline/sim/emit-corpus-batch.ts` processes (one per
digest) that print a DONE line per artefact; each artefact is then compared and installed exactly as a
node's own run would be.  A member that reads an artefact (基本的なドネイト the route facts, STSD's
cross-route) is built last in its process and only after this script answers its WAIT, i.e. after the
inputs are installed.  `--unbatched` runs the old way, and `--check` must say the same both ways: the batch
calls the same `build()` and `serialise()` as the entry files, which record their own md5 as `emitter_md5`
(the batch file is hashed into nothing).

--check READS COMMITTED INPUTS.  An emitter reads its upstream artefacts from analysis/ (the paths are
compiled into the profiles), never from the temp dir, so under --check a dependent is checked against the
committed upstream.  That is the right question for a gate (does the committed tree rebuild?), and an
upstream that does not rebuild is reported on its own line anyway.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import dataclass, field
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
ANALYSIS = REPO / 'analysis'
SIM = REPO / 'pipeline' / 'sim'

#: analysis/*.json no node here produces, each with its reason
EXCLUDED = {
    'rate-records.json': 'written by `Rscript analysis/rate_records.R --json` (R, not a bun emitter); '
                         'gated by pipeline/check_rate_records.py',
    'tst-openers-pc-examples.json': 'written by `python3 pipeline/sim/emit-tst-pc-examples.py` (Python over the '
                                    'tst-pcex-rs binary, not a bun emitter); re-run and byte-compared by its own '
                                    '--check in verify.yml\'s typescript job',
    'tst-openers-tp-pc-examples.json': 'written by `python3 pipeline/sim/emit-tst-pc-examples.py --tp` (Python over '
                                       'the tst-pcex-rs binary, not a bun emitter); re-run and byte-compared by its '
                                       'own `--tp --check`',
}

#: emitters the registries do not describe.  `reads`: analysis/ artefacts they read (data edges);
#: `sessions`: whether they read sessions/* themselves; `needs`: an executable that must exist, else skip;
#: `always_skip`: never re-run here, `skip_why` says why
EXTRA = [
    dict(name='dpc-facts', out='dpc-facts.json', argv=['emit-dpc-facts.ts'], sessions=True),
    dict(name='secondpc-facts', out='secondpc-facts.json', argv=['emit-secondpc-facts.ts'], sessions=True),
    dict(name='forecast-events', out='forecast-events.json', argv=['emit-forecast-events.ts'], sessions=True),
    dict(name='sdpc-loop-demos', out='sdpc-loop-demos.json', argv=['emit-sdpc-loop-demos.ts'],
         reads=['stickspin-demos.json']),
    dict(name='sdpcspin-orders', out='sdpcspin-orders.json', argv=['emit-route-orders.ts', '--opener', 'sdpcspin']),
    dict(name='sdpcspin-orders-cc', out='sdpcspin-orders-cc.json',
         argv=['emit-route-orders-cc.ts', '--opener', 'sdpcspin'], reads=['sdpcspin-orders.json'],
         needs='cc-oracle',
         skip_why='needs the cold-clear `cc-oracle` binary (result/bin/cc-oracle, built by the flake for '
                  'aarch64 only); CI re-queries it in the oracle-image job'),
    # the TST opener ranking: shapes.json + the Rust counter's output + the pc4 sampler's, merged by a Python
    # emitter whose raw inputs (the counter's and the sampler's stdout, ~14000 CPU-s) are not committed.
    # Constructed, never re-emitted here (`always_skip`); pipeline/openers/tst-openers.test.ts re-runs a
    # pinned cheap subset and checks every tiling, and pins the artefact's md5s.
    dict(name='tst-openers', out='tst-openers.json', argv=['emit-tst-openers.py'],
         always_skip=True,
         skip_why='its raw inputs (the Rust counter\'s and pc4 sampler\'s output, about four hours of CPU) are '
                  'not committed; run pipeline/sim/emit-tst-openers.py by hand (see its docstring); CI re-checks '
                  'it in pipeline/openers/tst-openers.test.ts'),
    # the T-placed ranking: the same Rust counter family (tst2bag-tp-rs), a recount of about an hour and a half on
    # four cores (O1-O5 in its docstring), merged by a Python emitter; constructed, never re-emitted here.
    # pipeline/openers/tst-openers-tp.test.ts re-runs a pinned subset and checks every board.
    dict(name='tst-openers-tp', out='tst-openers-tp.json', argv=['emit-tst-openers-tp.py'],
         always_skip=True,
         skip_why='its raw inputs (the counter\'s outputs at four soft-drop budgets, about 1.5 hours on four cores) '
                  'are not committed; run the O1-O5 commands in pipeline/sim/emit-tst-openers-tp.py\'s docstring '
                  'by hand; CI re-checks it in pipeline/openers/tst-openers-tp.test.ts'),
    # the self-play artefact rebuilds from the placements committed INSIDE it; re-running cold-clear
    # (--games <jsonl> --coach-seed <n>) needs the bot's JSONL, which is not committed, and is not done here
    dict(name='cutcopy-selfplay', out='cutcopy-selfplay.json', argv=['emit-cutcopy-selfplay.ts', '--rebuild'],
         reads=['cutcopy-selfplay.json']),
    # 千鳥格子練習場's drills: the qualifying hits replayed off their sessions' timelines, the self-play games
    # and our own design, rewound and re-placed in the practice engine (constructed, quarantined)
    dict(name='cutcopy-drills', out='cutcopy-drills.json', argv=['emit-cutcopy-drills.ts'], sessions=True,
         reads=['cutcopy-facts.json', 'cutcopy-selfplay.json', 'cutcopy-own.json']),
]

REGISTRY_TS = r"""
import { OPENERS } from '%(sim)s/route-openers.ts';
import { TECHNIQUES, TECHNIQUE_DEMOS, TECHNIQUE_OWN } from '%(sim)s/techniques.ts';
const flat = (h: any) => Object.values(h ?? {}).flat();
const out: any = { openers: {}, techniques: {}, demos: {}, own: {} };
for (const [k, P] of Object.entries(OPENERS) as any)
  out.openers[k] = { facts: P.artefactPath, demos: P.demosPath, hashed: flat(P.hashFiles) };
for (const [k, P] of Object.entries(TECHNIQUES) as any)
  out.techniques[k] = { facts: P.artefactPath, hashed: flat(P.hashFiles), reads: P.crossRoute ? [P.crossRoute.artefact] : [] };
for (const [k, P] of Object.entries(TECHNIQUE_DEMOS) as any)
  out.demos[k] = { out: P.artefactPath, hashed: flat(P.hashFiles) };
for (const [k, P] of Object.entries(TECHNIQUE_OWN) as any)
  out.own[k] = { out: P.artefactPath, hashed: flat(P.hashFiles) };
console.log(JSON.stringify(out));
"""


@dataclass
class Node:
    name: str
    out: str                       # file name under analysis/
    argv: list[str]                # after `bun pipeline/sim/`
    sessions: bool = False         # reads sessions/* itself
    data: set[str] = field(default_factory=set)    # out-names of artefacts it reads or hashes
    order: set[str] = field(default_factory=set)   # out-names it must run after (no data)
    skip_why: str | None = None
    tier: str = 'constructed'


def in_analysis(p: str) -> str | None:
    q = Path(os.path.normpath(p))
    return q.name if q.parent == ANALYSIS and q.suffix == '.json' else None


def registry() -> dict:
    r = subprocess.run(['bun', '-e', REGISTRY_TS % {'sim': SIM}], cwd=REPO, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f'emit-corpus: could not read the emitter registries through bun:\n{r.stderr}')
    return json.loads(r.stdout)


def plan() -> dict[str, Node]:
    reg = registry()
    nodes: list[Node] = []
    for k, o in reg['openers'].items():
        facts, demos = in_analysis(o['facts']), in_analysis(o['demos'])
        nodes.append(Node(facts[:-5], facts, ['emit-route-facts.ts', '--opener', k], sessions=True))
        # CLAUDE.md: emit the facts before the demos (the demos test classifies with the facts' classifier)
        nodes.append(Node(demos[:-5], demos, ['emit-route-demos.ts', '--opener', k], order={facts}))
    for k, t in reg['techniques'].items():
        facts = in_analysis(t['facts'])
        data = {a for a in map(in_analysis, t['hashed'] + t['reads']) if a and a != facts}
        nodes.append(Node(facts[:-5], facts, ['emit-technique-facts.ts', '--technique', k], sessions=True, data=data))
    for k, d in reg['demos'].items():
        out = in_analysis(d['out'])
        facts = in_analysis(reg['techniques'][k]['facts'])
        # a technique demo hashes its matcher's classifier files, so whatever the facts hash, it hashes too
        data = {a for a in map(in_analysis, d['hashed'] + reg['techniques'][k]['hashed']) if a}
        nodes.append(Node(out[:-5], out, ['emit-technique-demos.ts', '--technique', k], data=data - {facts},
                          order={facts}))
    for k, d in reg['own'].items():
        out = in_analysis(d['out'])
        data = {a for a in map(in_analysis, d['hashed'] + reg['techniques'][k]['hashed']) if a}
        nodes.append(Node(out[:-5], out, ['emit-technique-own.ts', '--technique', k], data=data))
    for e in EXTRA:
        n = Node(e['name'], e['out'], list(e['argv']), sessions=e.get('sessions', False),
                 data=set(e.get('reads', [])) - {e['out']})
        if e.get('always_skip'):
            n.skip_why = e['skip_why']
        elif e.get('needs') and not (shutil.which(e['needs']) or (REPO / 'result' / 'bin' / e['needs']).exists()):
            n.skip_why = e['skip_why']
        nodes.append(n)

    by_out = {n.out: n for n in nodes}
    if len(by_out) != len(nodes):
        sys.exit('emit-corpus: two nodes write one artefact')
    # completeness, both directions
    on_disk = {p.name for p in ANALYSIS.glob('*.json')}
    errors = [f'analysis/{f}: no emitter here produces it and EXCLUDED does not name it'
              for f in sorted(on_disk - set(by_out) - set(EXCLUDED))]
    errors += [f'EXCLUDED names analysis/{f}, which a node produces' for f in sorted(set(EXCLUDED) & set(by_out))]
    for n in nodes:
        for d in n.data | n.order:
            if d not in by_out and d not in EXCLUDED:
                errors.append(f'{n.name} depends on analysis/{d}, which nothing produces')
    if errors:
        sys.exit('emit-corpus: plan is incomplete:\n  ' + '\n  '.join(errors))
    # tiers: corpus = reads sessions, or a data edge (transitively) to a corpus node
    changed = True
    for n in nodes:
        n.tier = 'corpus' if n.sessions else 'constructed'
    while changed:
        changed = False
        for n in nodes:
            if n.tier != 'corpus' and any(by_out[d].tier == 'corpus' for d in n.data if d in by_out):
                n.tier, changed = 'corpus', True
    return {n.name: n for n in nodes}


#: entry files whose node may run inside one emit-corpus-batch.ts process instead: group, and the job's
#: <kind>:<key> there.  Route facts share a route digest, the rest one technique digest.
def batch_of(n: Node) -> tuple[str, str] | None:
    e, rest = n.argv[0], n.argv[1:]
    if e == 'emit-route-facts.ts' and rest[:1] == ['--opener']:
        return 'route', f'route:{rest[1]}'
    if e == 'emit-technique-facts.ts' and rest[:1] == ['--technique']:
        return 'technique', f'technique:{rest[1]}'
    if e == 'emit-dpc-facts.ts' and not rest:
        return 'technique', 'dpc:-'
    if e == 'emit-secondpc-facts.ts' and not rest:
        return 'technique', 'secondpc:-'
    return None


def md5(p: Path) -> str | None:
    return hashlib.md5(p.read_bytes()).hexdigest() if p.exists() else None


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--all', action='store_true')
    ap.add_argument('--check', action='store_true')
    ap.add_argument('--only', action='append', default=[])
    ap.add_argument('--jobs', type=int, default=os.cpu_count() or 1)
    ap.add_argument('--list', action='store_true')
    ap.add_argument('--unbatched', action='store_true',
                    help='run every node through its own entry file, with no shared digest')
    a = ap.parse_args()

    nodes = plan()
    by_out = {n.out: n for n in nodes.values()}
    if a.only:
        bad = [o for o in a.only if o not in nodes]
        if bad:
            sys.exit(f'emit-corpus: --only: unknown {bad}; known: {", ".join(sorted(nodes))}')
        chosen = {o: nodes[o] for o in a.only}
        # --only runs what it names and nothing upstream: say which committed inputs it will read,
        # since a stale one is reproduced exactly and every byte-identity gate agrees with it
        for o in a.only:
            up = sorted(by_out[d].name for d in nodes[o].data if d in by_out and by_out[d].name not in chosen)
            if up and not a.list:
                print(f'emit-corpus: --only {o} reads {", ".join(up)} as committed; '
                      f'if any of them is stale, add --only for it too (it runs first)', file=sys.stderr)
    else:
        chosen = {k: n for k, n in nodes.items() if a.all or n.tier == 'corpus'}

    if a.list:
        for tier in ('corpus', 'constructed'):
            print(f'[{tier}]' + ('' if tier == 'corpus' else '   (only with --all)'))
            for n in sorted((n for n in nodes.values() if n.tier == tier), key=lambda n: n.name):
                edges = sorted(n.data) + [f'(after {o})' for o in sorted(n.order)]
                b = batch_of(n)
                print(f'  {n.name:<22} {" ".join(n.argv)}' + (f'   [batched: {b[0]} digest]' if b else '') + (f'\n  {"":<22} <- {", ".join(edges)}' if edges else '')
                      + (f'\n  {"":<22} SKIPPED: {n.skip_why}' if n.skip_why else ''))
        for f, why in EXCLUDED.items():
            print(f'[excluded] {f}: {why}')
        return 0

    tmp = Path(tempfile.mkdtemp(prefix='emit-corpus-'))
    results: dict[str, tuple[str, float]] = {}
    skipped = [(n.name, n.skip_why) for n in chosen.values() if n.skip_why]
    todo = {k: n for k, n in chosen.items() if not n.skip_why}
    deps = {k: {by_out[d].name for d in n.data | n.order if d in by_out and by_out[d].name in todo}
            for k, n in todo.items()}
    # a cycle would leave every thread below waiting forever, so refuse one up front
    left, ready = dict(deps), set()
    while left:
        free = [k for k, d in left.items() if d <= ready]
        if not free:
            sys.exit(f'emit-corpus: dependency cycle among {sorted(left)}')
        for k in free:
            ready.add(k)
            del left[k]
    groups: dict[str, list[str]] = {}
    if not a.unbatched:
        for k, n in sorted(todo.items()):
            g = batch_of(n)
            if g:
                groups.setdefault(g[0], []).append(k)
        # a member reading a sibling of its own group cannot be gated inside the one process: run it alone
        for g, ks in list(groups.items()):
            alone = {k for k in ks if deps[k] & set(ks)}
            groups[g] = [k for k in ks if k not in alone]
            if len(groups[g]) == 0:
                del groups[g]
    in_group = {k for ks in groups.values() for k in ks}
    lock = threading.Lock()
    slots = threading.Semaphore(max(1, a.jobs))
    finished = {k: threading.Event() for k in todo}
    failed_logs: dict[str, str] = {}
    digests: list[tuple[str, int, float]] = []
    t0 = time.monotonic()

    def settle(name: str, tgt: Path) -> str:
        """Compare a freshly written artefact with the committed one; outside --check, install it."""
        dst = ANALYSIS / todo[name].out
        if not tgt.exists():
            return 'FAILED'
        if not dst.exists():
            state = 'new'
        elif md5(tgt) == md5(dst):
            state = 'unchanged'
        else:
            state = 'DIFFERS' if a.check else 'CHANGED'
        if not a.check and state != 'unchanged':
            with lock:
                os.replace(tgt, dst) if tgt.stat().st_dev == dst.parent.stat().st_dev else shutil.copyfile(tgt, dst)
        return state

    def record(name: str, state: str, dt: float, log: str = '') -> None:
        with lock:
            results[name] = (state, dt)
            if log:
                failed_logs[name] = log
            print(f'  {state:<10} {dt:7.1f} s  analysis/{todo[name].out}', flush=True)
        finished[name].set()

    def inputs_ok(name: str) -> bool:
        for d in deps[name]:
            finished[d].wait()
        return not any(results[d][0] == 'FAILED' or results[d][0].startswith('NOT RUN') for d in deps[name])

    def run_one(name: str) -> None:
        n = todo[name]
        if not inputs_ok(name):
            return record(name, 'NOT RUN (an input failed)', 0.0)
        tgt = tmp / n.out
        with slots:
            s = time.monotonic()
            r = subprocess.run(['bun', str(SIM / n.argv[0]), *n.argv[1:], '--out', str(tgt)], cwd=REPO,
                               capture_output=True, text=True)
            dt = time.monotonic() - s
        if r.returncode != 0 or not tgt.exists():
            return record(name, 'FAILED', dt, (r.stderr or r.stdout)[-4000:])
        record(name, settle(name, tgt), dt)

    def run_group(group: str, members: list[str]) -> None:
        """One emit-corpus-batch.ts process for every member: one digest, a DONE line per artefact."""
        waits = [k for k in members if deps[k]]
        argv = ['bun', str(SIM / 'emit-corpus-batch.ts')]
        for k in members:
            argv += ['--job', f'{k}:{batch_of(todo[k])[1]}:{tmp / todo[k].out}']
        for k in waits:
            argv += ['--wait', k]
        errf = tempfile.TemporaryFile(mode='w+')
        slots.acquire()
        held = True
        s = time.monotonic()
        p = subprocess.Popen(argv, cwd=REPO, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errf, text=True)
        try:
            for line in p.stdout:
                ev, _, rest = line.rstrip('\n').partition(' ')
                if ev == 'DIGEST':
                    with lock:
                        digests.append((rest.split()[0], len(members), float(rest.split()[1])))
                elif ev == 'DONE':
                    name, dt = rest.split()
                    record(name, settle(name, tmp / todo[name].out), float(dt))
                elif ev == 'FAILED':
                    name, msg = rest.split(' ', 1)
                    record(name, 'FAILED', 0.0, json.loads(msg)[-4000:])
                elif ev == 'SKIPPED':
                    record(rest, 'NOT RUN (an input failed)', 0.0)
                elif ev == 'WAIT':
                    slots.release()           # idle while it waits: the slot may be the one its inputs need
                    held = False
                    ok = inputs_ok(rest)
                    slots.acquire()
                    held = True
                    p.stdin.write('GO\n' if ok else 'SKIP\n')
                    p.stdin.flush()
                else:
                    raise RuntimeError(f'emit-corpus-batch.ts said {line!r}')
            p.wait()
        finally:
            if held:
                slots.release()
            if p.poll() is None:
                p.kill()
            errf.seek(0)
            err = errf.read()
            errf.close()
        for k in members:
            if not finished[k].is_set():
                record(k, 'FAILED', time.monotonic() - s, err[-4000:] or f'emit-corpus-batch.ts exited {p.returncode}')

    threads = [threading.Thread(target=run_group, args=(g, ks)) for g, ks in groups.items()]
    threads += [threading.Thread(target=run_one, args=(k,)) for k in sorted(todo) if k not in in_group]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    wall = time.monotonic() - t0
    shutil.rmtree(tmp, ignore_errors=True)

    for name, why in skipped:
        print(f'  {"SKIPPED":<10} {"":>9}  analysis/{nodes[name].out}: {why}')
    if not a.only and not a.all:
        n_con = sum(1 for n in nodes.values() if n.tier == 'constructed')
        print(f'  ({n_con} constructed artefacts no session feeds were not run; --all runs them)')
    for f, why in EXCLUDED.items():
        print(f'  {"EXCLUDED":<10} {"":>9}  analysis/{f}: {why}')
    for name, log in failed_logs.items():
        print(f'\n--- {name} failed:\n{log}', file=sys.stderr)
    for group, n, dt in digests:
        print(f'  {"DIGEST":<10} {dt:7.1f} s  one {group} digest, shared by the batched artefacts above')
    serial = sum(dt for _, dt in results.values()) + sum(dt for _, _, dt in digests)
    states = [s for s, _ in results.values()]
    print(f'emit-corpus: {len(results)} run, serial-equivalent {serial:.1f} s, wall {wall:.1f} s '
          f'(--jobs {a.jobs}{", unbatched" if a.unbatched else ""}); ' + ', '.join(f'{states.count(s)} {s}' for s in sorted(set(states))))
    bad = any(s in ('FAILED', 'DIFFERS', 'new') or s.startswith('NOT RUN') for s in states) if a.check \
        else any(s == 'FAILED' or s.startswith('NOT RUN') for s in states)
    return 1 if bad else 0


if __name__ == '__main__':
    sys.exit(main())
