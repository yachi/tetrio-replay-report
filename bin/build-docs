#!/usr/bin/env python3
"""Regenerate docs/ (the GitHub Pages site) from the sessions.

    bin/build-docs            regenerate
    bin/build-docs --check    verify docs/ matches the sessions, write nothing

Copies each session's self-contained report into docs/ under a clean name and
regenerates docs/index.html from facts.json + the proof maps — so the landing
page can never drift from the data it describes. Re-run after adding a session.

`--check` exists because that promise had a hole: CI verified sessions/ in depth
but never checked that docs/ had been regenerated from it, and nothing reruns this
script automatically. A whole section (T-Spin Forecast) once lived in
sessions/2026-07-22/report/report.html and was absent from the published
docs/2026-07-22.html, so the page readers actually load was a different document
from the one every gate had passed. --check is the same shape as
`pipeline.build_report --check`: exit 1 and name the drifting files.
"""
import argparse
import filecmp
import json
import shutil
import sys
from html import escape
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DOCS = REPO / "docs"
SESSIONS = REPO / "sessions"

sys.path.insert(0, str(REPO))
from pipeline import forecast_pooled  # noqa: E402  (needs REPO on the path first)

# (session dir, artefact subdir, output name, label, blurb)
#
# One published report per session. sessions/2026-07-24/ also contains a lighter
# "即場戰報" with its own independent 20-claim proof layer (sessions/2026-07-24/proof),
# but every fact in it is already covered by that session's full report — publishing
# both just put two cards for the same night on the page. It stays in the repo as a
# cross-check artefact and is still verified by CI; it is simply not a separate report.
ARTEFACTS = [
    ("2026-07-22", "report", "2026-07-22.html", "完整戰報",
     "十場 series、79 局，每個數字都有 Dafny lemma。"),
    ("2026-07-24", "report", "2026-07-24.html", "完整戰報",
     "七場 series、50 局，pinglamb 復仇戰。"),
    ("2026-07-28", "report", "2026-07-28.html", "完整戰報",
     "八場 series、64 局，yachi 贏晒頭兩場之後俾人連斬六場。"),
    ("2026-08-01", "report", "2026-08-01.html", "完整戰報",
     "七場 series、53 局，梅花間竹輪住贏，最後一場定生死。"),
]
LOOSE_REPORTS = {}


def load(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


def proof_map_rows(path):
    data = load(path)
    return data if isinstance(data, list) else [dict(v, id=k) for k, v in data.items()]


def summarize(session, artefact):
    """Derive the headline numbers straight from the session's own data."""
    base = SESSIONS / session / (artefact or "proof")
    facts_file = next(
        (p for p in sorted(base.glob("facts*.json")) if not p.name.startswith("facts2")), None
    )
    if facts_file is None:
        return None
    facts = load(facts_file)
    players = facts["players"]
    wins = {p: 0 for p in players}
    round_wins = {p: 0 for p in players}
    rounds = 0
    for match in facts["matches"]:
        wins[match["winner"]] += 1
        rounds += len(match["rounds"])
        for rnd in match["rounds"]:
            round_wins[rnd["winner"]] += 1
    claims = 0
    for pm in list(base.glob("*proof-map*.json")):
        claims += len(proof_map_rows(pm))
    champ = max(wins, key=lambda p: wins[p])
    # Scores are rendered in PLAYER order (players[0] : players[1]) so they read
    # correctly next to the names. Never champion-first — that silently reverses
    # the meaning whenever players[0] is not the winner.
    left, right = players[0], players[1]
    return {
        "players": players,
        "champion": champ,
        "score": f"{wins[left]}:{wins[right]}",
        "rounds_score": f"{round_wins[left]}:{round_wins[right]}",
        "matches": len(facts["matches"]),
        "rounds": rounds,
        "claims": claims,
    }


CSS = """
*,*::before,*::after{box-sizing:border-box}
:root{
  --bg:#f5f6fa; --card:#fff; --ink:#12141c; --muted:#6b7080; --line:rgba(18,20,28,.12);
  --p1:#0e8f9e; --p2:#7c3aed; --accent:#0e8f9e;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0a0c12; --card:#141824; --ink:#eef1f8; --muted:#8f96ab; --line:rgba(255,255,255,.10);
        --p1:#22d3ee; --p2:#a78bfa; --accent:#22d3ee}
}
:root[data-theme="dark"]{--bg:#0a0c12;--card:#141824;--ink:#eef1f8;--muted:#8f96ab;
  --line:rgba(255,255,255,.10);--p1:#22d3ee;--p2:#a78bfa;--accent:#22d3ee}
:root[data-theme="light"]{--bg:#f5f6fa;--card:#fff;--ink:#12141c;--muted:#6b7080;
  --line:rgba(18,20,28,.12);--p1:#0e8f9e;--p2:#7c3aed;--accent:#0e8f9e}
