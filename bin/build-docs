"""


def render_index(cards, totals, pooled_html=None):
    parts = [
        '<!doctype html><html lang="zh-HK"><head><meta charset="utf-8">',
        "<title>TETR.IO 對戰戰報 — 每個數字都有證明</title>",
        '<meta name="viewport" content="width=device-width, initial-scale=1">',
        '<meta name="description" content="TETR.IO 1v1 對戰分析報告，每一句數據都由 Dafny 形式驗證。">',
        f"<style>{CSS}</style></head><body><div class='wrap'>",
        "<p class='kicker'>TETR.IO · 1v1 SERIES REPORTS</p>",
        "<h1>每個數字都有證明嘅戰報</h1>",
        "<p class='lede'>每份戰報嘅數據由兩個獨立寫嘅 parser 抽出並互相對數，"
        "每一句可以數得出嘅說話都寫成一條 claim，再由 Dafny 逐條形式驗證；"
        "mutation test 保證啲 lemma 唔係擺設。CI 每次 push 都會重跑晒所有 gate。</p>",
        f"<p class='lede'><strong>{totals['sessions']}</strong> 個 session · "
        f"<strong>{totals['matches']}</strong> 場 match · "
        f"<strong>{totals['rounds']}</strong> 局 · "
        f"<strong>{totals['claims']}</strong> 條已驗證 claim</p>",
        "<h2>戰報</h2><div class='grid'>",
    ]
    for c in cards:
        s = c["summary"]
        parts.append(
            f"<a class='card' href='{escape(c['href'])}'>"
            f"<div class='date'>{escape(c['date'])}</div>"
            f"<div class='title'>{escape(c['label'])}</div>"
            f"<div class='vs'><span class='p1'>{escape(s['players'][0])}</span>"
            f"<b>{escape(s['score'])}</b>"
            f"<span class='p2'>{escape(s['players'][1])}</span></div>"
            f"<div class='meta'>局數 {escape(s['rounds_score'])} · "
            f"{s['matches']} 場 · {s['rounds']} 局 · 冠軍 {escape(s['champion'])}</div>"
            f"<p class='blurb'>{escape(c['blurb'])}</p>"
            f"<span class='pill'>✓ {s['claims']} 條 claim 已證明</span></a>"
        )
    parts.append("</div>")
    # Simulator-derived, and placed AFTER the proved reports so nothing above it is coloured by
    # it. Renders nothing at all when no session has a forecast artefact — see forecast_pooled.
    if pooled_html:
        parts.append(pooled_html)
    parts.append("<h2>工具</h2><div class='grid'>")
    parts.append(
        "<a class='card' href='analyzer.html'>"
        "<div class='date'>TOOL</div><div class='title'>Replay 分析器</div>"
        "<p class='blurb'>掉一個 <code>.ttrm</code> 入去就即刻出即場戰報，"
        "全部喺你部機行，冇嘢上傳。</p></a>"
    )
    parts.append(
        "<a class='card' href='https://github.com/yachi/tetrio-replay-report'>"
        "<div class='date'>SOURCE</div><div class='title'>GitHub repo</div>"
        "<p class='blurb'>抽取器、claim ledger、Dafny 證明、mutation test、"
        "同埋 CI 全部喺度，可以自己重跑。</p></a>"
    )
    parts.append("</div>")
    parts.append(
        "<footer><p>Dafny 證明嘅係「claim ⇔ 抽出嚟嘅數據」。"
        "數據本身啱唔啱，靠兩個獨立 parser 完全一致嚟兜底 —— 呢兩件事係分開嘅，唔好溝埋。</p>"
        "<p>上面數嘅係已出版戰報嘅 claim。repo 裏面仲有一個 20 條 claim 嘅"
        "即場戰報做交叉驗證，一樣過 CI，但內容已經全部包含喺當晚嘅完整戰報，所以唔另外出版。</p>"
        "<p>Replays &amp; reports 由 yachi 同 pinglamb 對戰產生，兩位都同意公開。</p></footer>"
    )
    parts.append("</div></body></html>")
    return "".join(parts)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--check", action="store_true",
                    help="verify docs/ matches the sessions; write nothing")
    args = ap.parse_args(argv)
    check = args.check
    drift = []

    DOCS.mkdir(exist_ok=True)
    cards = []
    totals = {"sessions": 0, "matches": 0, "rounds": 0, "claims": 0}
    seen_sessions = set()

    for session, artefact, out_name, label, blurb in ARTEFACTS:
        if artefact:
            src = SESSIONS / session / artefact / "report.html"
        else:
            src = SESSIONS / session / LOOSE_REPORTS[(session, artefact)]
        if not src.exists():
            print(f"  skip {src.relative_to(REPO)} (missing)")
            continue
        summary = summarize(session, artefact)
        if summary is None:
            print(f"  skip {session}/{artefact} (no facts)")
            continue
        if check:
            dst = DOCS / out_name
            if not dst.exists() or not filecmp.cmp(src, dst, shallow=False):
                drift.append(f"docs/{out_name} differs from {src.relative_to(REPO)}")
        else:
            shutil.copyfile(src, DOCS / out_name)
        cards.append(
            {"href": out_name, "date": session, "label": label,
             "blurb": blurb, "summary": summary}
        )
        totals["claims"] += summary["claims"]
        if session not in seen_sessions:
            seen_sessions.add(session)
            totals["sessions"] += 1
            totals["matches"] += summary["matches"]
            totals["rounds"] += summary["rounds"]
        if not check:
            print(f"  copied {src.relative_to(REPO)} -> docs/{out_name}")

    analyzer = REPO / "tools" / "analyzer.html"
    if analyzer.exists():
        dst = DOCS / "analyzer.html"
        if check:
            if not dst.exists() or not filecmp.cmp(analyzer, dst, shallow=False):
                drift.append("docs/analyzer.html differs from tools/analyzer.html")
        else:
            shutil.copyfile(analyzer, dst)
            print("  copied tools/analyzer.html -> docs/analyzer.html")

    # Computed from the four committed artefacts at render time rather than read from a pooled
    # artefact of its own: --check regenerates this, so the figure cannot go stale against its
    # inputs, and there is no extra file to forget to rebuild.
    pooled_html = forecast_pooled.section(forecast_pooled.pool(forecast_pooled.load_all(str(REPO))))

    # The pooled figure has no Dafny lemma behind it, so its controls ARE its gate. Run them on
    # every build and every check; a bad control here is a published wrong number.
    problems = forecast_pooled.selftest(str(REPO))
    if problems:
        for p in problems:
            print(f"FAIL pooled forecast: {p}", file=sys.stderr)
        return 1

    index = render_index(cards, totals, pooled_html)
    if check:
        cur = (DOCS / "index.html").read_text(encoding="utf-8") if (DOCS / "index.html").exists() else None
        if cur != index:
            drift.append("docs/index.html differs from what the sessions generate")
        if drift:
            for d in drift:
                print(f"DRIFT: {d}", file=sys.stderr)
            print("run `bin/build-docs` to republish", file=sys.stderr)
            return 1
        print(
            f"ok  docs/ matches the sessions — {totals['sessions']} sessions, "
            f"{totals['matches']} matches, {totals['rounds']} rounds, "
            f"{totals['claims']} verified claims"
        )
        return 0

    (DOCS / ".nojekyll").write_text("", encoding="utf-8")
    (DOCS / "index.html").write_text(index, encoding="utf-8")
    print(
        f"wrote docs/index.html — {totals['sessions']} sessions, "
        f"{totals['matches']} matches, {totals['rounds']} rounds, "
        f"{totals['claims']} verified claims"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
