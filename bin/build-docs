.card{background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:1.35rem 1.4rem;text-decoration:none;color:inherit;display:block;
  transition:transform .15s ease,border-color .15s ease}
.card:hover{transform:translateY(-2px);border-color:var(--accent)}
.card .date{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;color:var(--muted)}
.card .title{font-weight:650;font-size:1.12rem;margin:.35rem 0 .1rem}
.vs{display:flex;align-items:baseline;gap:.5rem;margin:.75rem 0 .5rem;flex-wrap:wrap}
