#!/usr/bin/env python3
"""Run the REPO-WIDE CI gates locally — the last mile no other bin/ script reaches.

    bin/verify-repo              every repo-wide gate a push to a PR would run
    bin/verify-repo --fast       omit the slow tier (coverage, oracle-image)
    bin/verify-repo --weekly     add the schedule-only jobs and steps
    bin/verify-repo --sessions   add the two per-session matrices, expanded from the workflow
    bin/verify-repo --session 2026-11-05
                                 both matrices, but only their entries for that date
                                 (repeatable); every entry left out is named in the summary
    bin/verify-repo --check      completeness only: run nothing, just check this script
                                 still knows every job and step in .github/workflows/
    bin/verify-repo --list       print the plan and exit
    bin/verify-repo --selftest   plant corruptions and require each to be rejected
    bin/verify-repo --jobs 4     run independent jobs four at a time (the `verify` matrix
                                 stays one serial lane); output is buffered per job
    bin/verify-repo --changed    skip a job whose input hash was green here before
                                 (`--changed=verify` runs it anyway and says if it went red)
    bin/verify-repo --audit-inputs
                                 run each job under strace and fail on a tracked file it
                                 opened outside its input closure (Linux)
    bin/verify-repo --timings t.json
                                 write per-job and per-step wall seconds

THE INPUT GATE (yachi's decision of 2026-11-17).  A PR or main push may skip a CI job whose
input closure (`pipeline/input_closure.py`) is unchanged since a green run; a daily schedule
runs everything.  Every gated job carries three infrastructure steps — `Input gate` second,
`Audit the input closure` second to last, `Record green inputs` last — and every other step
carries the gate's `if:`.  Those three are CI plumbing, never run here; the gate's `if:` is
stripped before the "every `if:` is decided" rule, so a step whose condition was
`env.INPUTS_UNCHANGED != '1' && (X)` is held to X exactly as before.  `--check` refuses a
gated job that is missing any of it, a job with neither `roots` nor `never_skip`, a
`never_skip` job that is gated, and an entry point a run block names that resolves to no file.

WHY THIS EXISTS.  `bin/new-session` covers steps 1-6 of adding a session and
`bin/verify-session` takes ONE artefact directory, where every gate it runs is
internal to that directory.  Ten of the thirteen CI jobs are repo-wide, and `bin/`
could run exactly one of them (`docs`, via `bin/build-docs --check`).  So the last
mile of adding a session was discovered from GitHub rather than locally: on
2026-08-20 four jobs went red on PR #14 (`docs`, `manifest`, `preregistrations`,
`coverage`) and three were reproducible here in minutes.  Three push->CI->fix
cycles, with the user in the loop for each.

THE ONE DESIGN CONSTRAINT.  The command list is DERIVED from the workflow files,
never copied.  A hardcoded list in here would be the eleventh hand-maintained
list in this repo and it would fail in the direction that reads green — a job
added to CI and not to the script leaves the script silently narrower than the
thing it stands in for.  So:

  * every job in .github/workflows/*.yml must appear in PLAN, and every PLAN
    entry must name a job that exists.  Either direction is an error.
  * inside a job we run, every `run:` step must be either executed or named in
    that entry's `skips` with a reason.  A new step is an error, and so is a
    `skips` key no step matches.
  * the text executed is the step's own `run:` block, read out of the YAML.  A
    command that changes in CI changes here, with nothing to update.

That is the same shape as check_finesse_denominator's rule that every plotted
accessor must be classified: an unclassified key fails, so a new one forces the
decision instead of leaving it to whoever notices.

WHAT IT IS NOT.  It does not replace `bin/verify-session`; by default it does not
run the `verify` and `pipeline` matrices at all (`--sessions` does).  And it
reports, rather than hides, every divergence from CI: a job it could not run, a
step it skipped, a toolchain whose local version is not the pinned one.  A run
that quietly covered less than it claimed would be the very failure this tool was
written to stop happening in CI.

NO PyYAML AT RUNTIME.  Every python gate in this repo is stdlib-only and runs on
whatever `python3` is on PATH, in CI too.  The scanner below is a strict line
reader that REFUSES any construct it does not recognise, so it cannot silently
parse less than is there.  `--selftest` cross-checks it against PyYAML when PyYAML
is importable — a second implementation as the oracle, which is this repo's own
argument for the extractors applied one level up.
"""
import argparse
import copy
import json
import os
import re
import platform
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
WORKFLOWS = REPO / ".github" / "workflows"
sys.path.insert(0, str(REPO))
from pipeline import input_closure as ic  # noqa: E402

# ---------------------------------------------------------------- the scanner

# Keys valid directly under jobs.<id> per the workflow syntax.  An unknown key is
# a parse error, not a skip: a job carrying something this scanner cannot model
# may well be doing something it cannot reproduce.
JOB_KEYS = {
    "name", "permissions", "needs", "if", "runs-on", "environment", "concurrency",
    "outputs", "env", "defaults", "steps", "strategy", "continue-on-error",
    "container", "services", "timeout-minutes",
}
STEP_KEYS = {
    "name", "id", "if", "uses", "run", "with", "env", "working-directory",
    "shell", "continue-on-error", "timeout-minutes",
}


class ParseError(Exception):
    pass


class Step:
    def __init__(self, name, uses=None, run=None, cond=None, workdir=None, line=0):
        self.name, self.uses, self.run = name, uses, run
        self.cond, self.workdir, self.line = cond, workdir, line
        self.with_ = {}       # the `with:` map, scalars only; read for the setup-bun pin rule

    @property
    def kind(self):
        return "uses" if self.uses is not None else "run"


class Job:
    def __init__(self, file, name, line, env=None):
        self.file, self.name, self.line = file, name, line
        # The workflow-level `env:` this job sees. Held per job rather than merged
        # across files: verify.yml and dual-backed.yml both define one now (both carry
        # BUN_VERSION), and `pin_problems` refuses a key the two give different values.
        self.env = env if env is not None else {}
        self.runs_on = None
        self.cond = None
        self.needs = []
        self.matrix = {}
        self.steps = []
        self.permissions = None       # the job's own `permissions:` map, if it has one
        self.wf_permissions = {}      # the workflow's top-level map, which a job without one gets


def _indent(s):
    return len(s) - len(s.lstrip(" "))


def _blank(s):
    return not s.strip() or s.lstrip().startswith("#")


def _plain(val):
    """A plain YAML scalar ends at an unquoted ` #`.  The scanner must strip that
    the way the real parser does, or `uses: x@sha  # v4.2.2` compares unequal to
    what GitHub reads — which is exactly what the PyYAML oracle caught."""
    return re.sub(r"\s+#.*$", "", val.strip()).strip()


def scan_workflow(path, text):
    """Return (env, [Job]) for one workflow file.  Raises on anything unrecognised."""
    lines = text.split("\n")
    env, jobs = {}, []

    # top-level `env:` — the map the ${{ env.X }} interpolations resolve against.
    i = 0
    wf_perms = {}
    while i < len(lines):
        if lines[i].rstrip() == "permissions:":
            i += 1
            while i < len(lines) and (_blank(lines[i]) or _indent(lines[i]) >= 2):
                m = re.match(r"^  ([a-z-]+): *(\S+)", lines[i])
                if m:
                    wf_perms[m.group(1)] = _plain(m.group(2))
                i += 1
            continue
        if lines[i].rstrip() == "env:":
            i += 1
            while i < len(lines) and (_blank(lines[i]) or _indent(lines[i]) >= 2):
                m = re.match(r"^  ([A-Za-z_][A-Za-z0-9_]*): *(.*)$", lines[i])
                if m:
                    env[m.group(1)] = m.group(2).strip()
                i += 1
            continue
        if lines[i].rstrip() == "jobs:":
            break
        i += 1
    else:
        raise ParseError(f"{path.name}: no top-level `jobs:`")

    i += 1
    job = None
    while i < len(lines):
        ln, n = lines[i], _indent(lines[i])
        if _blank(ln):
            i += 1
            continue
        if n == 0:
            # `jobs:` is last in all three files, and this scanner assumes it.
            raise ParseError(f"{path.name}:{i+1}: column-0 content after `jobs:` — "
                             f"the scanner assumes `jobs:` is the final top-level key")
        if n == 2:
            m = re.match(r"^  ([A-Za-z0-9_-]+): *$", ln)
            if not m:
                raise ParseError(f"{path.name}:{i+1}: expected a job id, got {ln!r}")
            job = Job(path.name, m.group(1), i + 1, env)
            job.wf_permissions = wf_perms
            jobs.append(job)
            i += 1
            continue
        if job is None:
            raise ParseError(f"{path.name}:{i+1}: content before the first job")
        if n == 4:
            m = re.match(r"^    ([A-Za-z0-9_-]+): *(.*)$", ln)
            if not m:
                raise ParseError(f"{path.name}:{i+1}: expected a job key, got {ln!r}")
            key, val = m.group(1), _plain(m.group(2))
            if key not in JOB_KEYS:
                raise ParseError(f"{path.name}:{i+1}: unknown job key {key!r} in job {job.name!r}")
            if key == "runs-on":
                job.runs_on = val
            elif key == "if":
                job.cond = val
            elif key == "needs":
                # Only the one-line flow form `needs: [a, b]` (or a single id) is modelled; a
                # block list would be consumed below as a nested block and read as no needs.
                if not val:
                    raise ParseError(f"{path.name}:{i+1}: `needs:` must be one line, "
                                     f"`needs: [a, b]`")
                job.needs = [x.strip() for x in val.strip("[]").split(",") if x.strip()]
            if key == "steps":
                i = _scan_steps(path, lines, i + 1, job)
                continue
            if key == "strategy":
                i = _scan_strategy(path, lines, i + 1, job)
                continue
            i += 1
            if key == "permissions":
                job.permissions = {}
            # consume any nested block belonging to this key
            while i < len(lines) and (_blank(lines[i]) or _indent(lines[i]) > 4):
                m = re.match(r"^      ([a-z-]+): *(\S+)", lines[i])
                if key == "permissions" and m:
                    job.permissions[m.group(1)] = _plain(m.group(2))
                i += 1
            continue
        raise ParseError(f"{path.name}:{i+1}: unexpected indent {n} — {ln!r}")
    return env, jobs


def _scan_strategy(path, lines, i, job):
    """Capture matrix dimensions so the two matrices can be expanded, not retyped."""
    dim = None
    while i < len(lines) and (_blank(lines[i]) or _indent(lines[i]) > 4):
        ln = lines[i]
        if _blank(ln):
            i += 1
            continue
        n = _indent(ln)
        if n == 8:                                  # matrix dimension name
            m = re.match(r"^        ([A-Za-z0-9_-]+): *(.*)$", ln)
            if not m:
                raise ParseError(f"{path.name}:{i+1}: expected a matrix key, got {ln!r}")
            dim, inline = m.group(1), _plain(m.group(2))
            job.matrix.setdefault(dim, [])
            if inline:                              # flow sequence on one or more lines
                buf = inline
                while not buf.rstrip().endswith("]"):
                    i += 1
                    buf += " " + lines[i].strip()
                job.matrix[dim] = [v.strip().strip("'\"")
                                   for v in buf.strip()[1:-1].split(",") if v.strip()]
        elif n == 10 and ln.lstrip().startswith("- "):
            if dim is None:
                raise ParseError(f"{path.name}:{i+1}: matrix entry before a dimension")
            job.matrix[dim].append(ln.strip()[2:].strip().strip("'\""))
        i += 1
    return i


def _scan_steps(path, lines, i, job):
    step = None
    while i < len(lines) and (_blank(lines[i]) or _indent(lines[i]) > 4):
        ln = lines[i]
        if _blank(ln):
            i += 1
            continue
        n = _indent(ln)
        if n == 6 and ln.lstrip().startswith("- "):
            step = Step(None, line=i + 1)
            job.steps.append(step)
            rest = ln[8:]
            ln, n = "        " + rest, 8            # fall through to the key below
        if n != 8:
            raise ParseError(f"{path.name}:{i+1}: expected a step key at indent 8, got {ln!r}")
        if step is None:
            raise ParseError(f"{path.name}:{i+1}: step key before any `- `")
        m = re.match(r"^        ([A-Za-z0-9_-]+): *(.*)$", ln)
        if not m:
            raise ParseError(f"{path.name}:{i+1}: expected a step key, got {ln!r}")
        key, val = m.group(1), m.group(2)
        if key not in STEP_KEYS:
            raise ParseError(f"{path.name}:{i+1}: unknown step key {key!r}")
        if key == "run":
            if val.strip() == "|":
                body, i = _block(path, lines, i + 1)
                step.run = body
                continue
            if val.strip() in (">", ">-", "|-", "|+"):
                raise ParseError(f"{path.name}:{i+1}: unsupported block scalar {val.strip()!r} "
                                 f"— only `run: |` and a single line are modelled")
            step.run = _plain(val)
        elif key == "name":
            step.name = _plain(val)
        elif key == "uses":
            step.uses = _plain(val)
        elif key == "if":
            step.cond = _plain(val)
        elif key == "working-directory":
            step.workdir = _plain(val)
        i += 1
        if key in ("with", "env"):                  # nested map
            while i < len(lines) and (_blank(lines[i]) or _indent(lines[i]) > 8):
                m = re.match(r"^          ([A-Za-z0-9_-]+): *(.*)$", lines[i])
                if key == "with" and m:
                    step.with_[m.group(1)] = _plain(m.group(2))
                i += 1
    return i


def _block(path, lines, i):
    """Read a `run: |` literal block scalar.  Comment lines inside it are SHELL
    comments and part of the script — never skipped."""
    while i < len(lines) and not lines[i].strip():
        i += 1
    if i >= len(lines):
        raise ParseError(f"{path.name}: `run: |` with no body")
    base = _indent(lines[i])
    if base <= 8:
        raise ParseError(f"{path.name}:{i+1}: `run: |` body is not indented past the key")
    out = []
    while i < len(lines) and (not lines[i].strip() or _indent(lines[i]) >= base):
        out.append(lines[i][base:] if lines[i].strip() else "")
        i += 1
    return "\n".join(out).rstrip() + "\n", i


def load():
    env, jobs = {}, []
    for p in sorted(WORKFLOWS.glob("*.yml")):
        e, j = scan_workflow(p, p.read_text())
        env.update(e)
        jobs.extend(j)
    return env, jobs      # `env` is the union, kept only for callers wanting a summary


# ------------------------------------------------------------------- the plan

FAST, DEFAULT, SLOW, WEEKLY, SESSIONS = "fast", "default", "slow", "weekly", "sessions"

# The pinned toolchains.  CI installs each by sha256; locally we use what is on
# PATH and REPORT the version, because a gate that verified with a different
# verifier reproduced something other than CI.
TOOLCHAIN = {"dafny": "DAFNY_VERSION", "z3": "Z3_VERSION", "cvc5": "CVC5_VERSION",
             "bun": "BUN_VERSION", "lean": "LEAN_VERSION"}

# Why every install step is skipped rather than run: they `curl` a pinned asset
# and append to $GITHUB_PATH, neither of which means anything here.  The version
# check in its place is what says whether the local toolchain is CI's.
_TOOLCHAIN_SKIP = "installs a pinned asset into $GITHUB_PATH; the local %s is checked instead"


# A job may be unrunnable HERE without being unplanned. `unless` is the one
# mechanism for that — a named predicate and the reason — deliberately not a second
# "skip" field beside it: two ways to excuse a job is how one of them stops being
# exercised, and an escape hatch nothing takes is indistinguishable from a comment.
# The predicate is evaluated per run, so on an aarch64 Linux box `oracle-image` runs
# rather than being permanently excused, and either way the summary names it.  It was
# `sys.platform == "linux"` until 2026-10-10, which let an x86_64 Linux box attempt the
# build and fail on `packages.x86_64-linux.cc-oracle-image` not existing — the flake
# defines the image for aarch64 only, so the predicate has to name the ARCHITECTURE,
# which is what the job's own `runs-on: ubuntu-24.04-arm` names.
PREDICATES = {"aarch64-linux": (lambda: sys.platform == "linux"
                                and platform.machine() in ("aarch64", "arm64")),
              # The Pages deploy is a GitHub service, not a command: it has no local equivalent,
              # so it runs nowhere but CI and the summary names it as unrun everywhere else.
              "github-actions": lambda: os.environ.get("GITHUB_ACTIONS") == "true"}


class Entry:
    def __init__(self, tier, skips=None, needs=(), matrix=None, unless=None, roots=(),
                 never_skip=None):
        self.tier, self.skips = tier, dict(skips or {})
        self.needs, self.matrix = tuple(needs), matrix
        self.unless = unless          # (predicate name, reason) or None
        # The job's INPUT ROOTS: the directories and files its steps read that no code
        # import names (data, docs, transcriptions).  `pipeline/input_closure.py` adds bin/,
        # the job's own workflow text, every entry point its run blocks name and their
        # Python / TypeScript import closures.  `{session}` is the matrix value's session.
        self.roots = tuple(roots)
        # A reason this job is never skipped on an unchanged input hash, or None.  Such a
        # job carries no `Input gate` step, and completeness refuses one that does.
        self.never_skip = never_skip

    def blocked(self):
        """The reason this cannot run here, or None."""
        if self.unless and not PREDICATES[self.unless[0]]():
            return self.unless[1]
        return None


# Input roots shared by many jobs.  Over-wide on purpose: a root that is too wide costs a
# job that could have been skipped; one that is too narrow lets a red job read green.
CORPUS = ("sessions/", "analysis/")
DOCS = ("README.md", "CLAUDE.md", "ROADMAP.md")
SESSION = ("{session}", "sessions/*/report/facts.json", "analysis/", "spec/") + DOCS

PLAN = {
    # ---- the two per-session matrices.  Not repo-wide, so not in any default run.
    "verify": Entry(SESSIONS, matrix="artefact", needs=["dafny", "z3"], roots=SESSION, skips={
        "Install Dafny ${{ env.DAFNY_VERSION }} (pinned by sha256)": _TOOLCHAIN_SKIP % "dafny",
        "Install z3 ${{ env.Z3_VERSION }} (pinned by sha256)": _TOOLCHAIN_SKIP % "z3",
    }),
    "pipeline": Entry(SESSIONS, matrix="session", needs=["dafny", "z3", "cvc5"], roots=SESSION,
                      skips={
        "Install Dafny ${{ env.DAFNY_VERSION }} (pinned by sha256)": _TOOLCHAIN_SKIP % "dafny",
        "Install cvc5 ${{ env.CVC5_VERSION }} and z3 ${{ env.Z3_VERSION }} (pinned by sha256)":
            _TOOLCHAIN_SKIP % "cvc5/z3",
        "Mutation-test the generated proofs":
            "schedule/inputs.mutation only — MUTATION=1 bin/verify-session runs it",
    }),

    # ---- the repo-wide set: what only this script reaches.
    "cross-extractor": Entry(DEFAULT, needs=["bun", "jq", "sha256sum"], roots=CORPUS),
    "docs": Entry(FAST, roots=CORPUS + DOCS + ("spec/", "tools/")),
    # docs' selftests, split out on 2026-11-17 so the site render is not serial behind them.
    # The transcription gates read only the committed transcriptions (in their modules'
    # closure) and the fixtures beside them; the page audits read the corpus artefacts.
    "docs-transcriptions": Entry(FAST, roots=("spec/fixtures/",)),
    "docs-pages": Entry(FAST, roots=CORPUS + DOCS + ("spec/",)),
    "leave-one-out": Entry(FAST, roots=CORPUS + DOCS),
    "intense-round-corpus": Entry(FAST, roots=CORPUS + DOCS),
    "preregistrations": Entry(FAST, roots=CORPUS + DOCS + ("spec/",)),
    "stat-sources": Entry(FAST, roots=CORPUS + DOCS),
    # The job's command is `--rerun`, and what it does is decided by whether Rscript is
    # installed, not by which runner it is on: CI has no R and prints that it checked the
    # fingerprints only; here it re-derives the artefact and demands the committed bytes
    # back. Same command, two honest outcomes, and the weaker one announces itself.
    "rate-records": Entry(FAST, roots=CORPUS + DOCS),
    # Reads the seven committed opener-facts.json and byte-compares CLAUDE.md's bands
    # against them. No simulator run, so it is FAST — the artefacts are the input.
    "donation-bands": Entry(FAST, roots=CORPUS + DOCS),
    # Same seven artefacts, the other block: the confusion matrix, its board-equality
    # split, and the two engines' prefix lengths. Also FAST — no simulator run.
    "dual-engine": Entry(FAST, roots=CORPUS + DOCS),
    # Renders every session to trace the quantizers, so it is not instant — but it
    # writes nothing (the round table renders into a copy) and needs no toolchain.
    "rounding": Entry(FAST, roots=CORPUS + DOCS),
    # This script's own gate. Running it here is not circular: the job's two commands
    # are --selftest and --check, neither of which executes any job, and both of which
    # are exactly what a local run should confirm before a push.
    "workflow-plan": Entry(FAST, never_skip="it checks the gates themselves; a skip would let a "
                                            "workflow edit that broke them go green"),
    # Sharded over two runners (`--shard=k/2`); each shard is a matrix entry with its own hash,
    # and both hash the same closure.
    "typescript": Entry(DEFAULT, needs=["bun"], matrix="shard",
                        roots=CORPUS + ("spec/", "tools/", "nix/")),
    "manifest": Entry(DEFAULT, needs=["bun"], roots=CORPUS + ("tools/",)),
    "spec": Entry(DEFAULT, needs=["dafny"], roots=("spec/",), skips={
        "Install Dafny ${{ env.DAFNY_VERSION }} (pinned by sha256)": _TOOLCHAIN_SKIP % "dafny",
        "Mutation-test the spec": "schedule/inputs.mutation only — --weekly runs it",
    }),
    # spec's T3 recount, split out of spec on 2026-11-17 so it runs beside the verifier rather
    # than after it. `route_orders_data.py --check` still runs `dafny verify` on the proof it
    # compiles, so the job installs Dafny like spec does.
    "spec-recount": Entry(DEFAULT, needs=["dafny"], roots=("spec/", "analysis/sdpcspin-orders.json"),
                          skips={
        "Install Dafny ${{ env.DAFNY_VERSION }} (pinned by sha256)": _TOOLCHAIN_SKIP % "dafny",
    }),
    "lean": Entry(DEFAULT, needs=["lean", "lake"], roots=("lean/", "analysis/sdpcspin-orders.json"),
                  skips={
        "Install Lean ${{ env.LEAN_VERSION }} (pinned by sha256)": _TOOLCHAIN_SKIP % "lean",
        "Mutation-test the Lean proofs": "schedule/inputs.mutation only — --weekly runs it",
    }),
    "coverage": Entry(SLOW, roots=CORPUS + DOCS),
    # `nix build .#cc-oracle-image` targets aarch64-linux; the job's own comment says
    # it is built "the way the local Mac could not".
    "oracle-image": Entry(SLOW, needs=["nix", "bun"],
                          roots=CORPUS + ("tools/", "nix/", "flake.nix", "flake.lock"), unless=(
        "aarch64-linux", "needs an aarch64 Linux runner (ubuntu-24.04-arm) — the image is aarch64-linux "
                 "and nix has no builder for it here")),
    "coverage-round": Entry(WEEKLY, roots=CORPUS + DOCS),
    # wikitext-sources.yml: the job IS a network fetch of harddrop's pinned revisions, and CI runs it
    # on schedule/workflow_dispatch only, so it sits in the tier --weekly selects. Run locally it is
    # the same live fetch, not a stand-in; its offline half (--selftest) is a step of `docs`, FAST.
    "wikitext-sources": Entry(WEEKLY, never_skip="a live fetch of harddrop's pinned revisions; it "
                                                 "runs on schedule and dispatch only, where nothing "
                                                 "is skipped"),
    # verify.yml's Pages deploy: every step is a `uses:`, so there is nothing here to run, and
    # it runs only on a push to main in CI. Planned so its `needs:` list is checked (see
    # `deploy_problems`), excused so the summary says it did not run instead of printing ok.
    "deploy": Entry(FAST, never_skip="publishes the site; it has no inputs of its own to hash", unless=(
        "github-actions", "publishes to GitHub Pages; runs only in CI, on a push to main")),
}

WEEKLY_STEP_SKIPS = {"Mutation-test the spec", "Mutation-test the generated proofs",
                     "Mutation-test the Lean proofs"}


# ------------------------------------------------------------- the input gate

GATE_STEP, AUDIT_STEP, RECORD_STEP = "Input gate", "Audit the input closure", "Record green inputs"
INFRA = (GATE_STEP, AUDIT_STEP, RECORD_STEP)
GATE_IF = "env.INPUTS_UNCHANGED != '1'"
# docs only: on a main push whose inputs are unchanged, one render and the Pages upload still
# run, because the deploy needs a site and the Pages artifact expires in a day.
MAIN_PUSH_IF = GATE_IF + " || (github.event_name == 'push' && github.ref == 'refs/heads/main')"
MAIN_PUSH_JOBS = {"docs"}
AUDIT_IF = GATE_IF + " && github.event.schedule == '41 5 * * *'"
RECORD_IF = "success() && " + GATE_IF
UPLOAD_ARTIFACT = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"
RECORD_WITH = {"name": "${{ env.INPUTS_ARTIFACT }}", "path": "${{ runner.temp }}/green-inputs/",
               "retention-days": "90", "if-no-files-found": "error", "overwrite": "true"}


def _closes_at_end(text):
    """True iff `text` starts with `(` whose matching `)` is its last character."""
    if not (text.startswith("(") and text.endswith(")")):
        return False
    depth = 0
    for i, c in enumerate(text):
        depth += c == "("
        depth -= c == ")"
        if depth == 0:
            return i == len(text) - 1
    return False


def split_gate(cond, job_name=None):
    """(gated, residual condition) for a step's `if:`.  Exactly three gated forms are
    accepted: the gate alone, `<gate> && (X)` (residual X, which must then be decided in
    PLAN like any `if:`), and docs' main-push form.  Any OTHER mention of INPUTS_UNCHANGED
    raises: a gate condition of a new shape is one nobody checked skips what it should."""
    if cond is None:
        return False, None
    if cond == GATE_IF:
        return True, None
    if cond == MAIN_PUSH_IF and job_name in MAIN_PUSH_JOBS:
        return True, None
    pre = GATE_IF + " && "
    if cond.startswith(pre) and _closes_at_end(cond[len(pre):]):
        inner = cond[len(pre) + 1:-1]
        if "INPUTS_UNCHANGED" not in inner:
            return True, inner
    if "INPUTS_UNCHANGED" in cond:
        raise ParseError(f"`if: {cond}` mentions INPUTS_UNCHANGED in a form bin/verify-repo "
                         f"does not accept (the gate, `{pre}(X)`, or docs' main-push form)")
    return False, cond


def _is_infra(step):
    return step.name in INFRA


def gate_run(verb, job):
    dim = next(iter(job.matrix), None) if job.matrix else None
    return f"python3 bin/input-hash {verb} {job.name}" + \
        (f' "${{{{ matrix.{dim} }}}}"' if dim else "")


_CLOSURES = {}


def closure_of(job, entry, mv, tree):
    """The job's input closure, memoised on everything it is computed from."""
    key = (job.file, job.name, mv, entry.roots, tuple((s.name, s.run, s.workdir) for s in job.steps),
           id(tree), str(WORKFLOWS), (WORKFLOWS / job.file).read_text())
    if key not in _CLOSURES:
        _CLOSURES[key] = ic.closure(job, entry, interpolate, entry.matrix if mv else None, mv,
                                    tree, WORKFLOWS)
    return _CLOSURES[key]


_TREE = []


def the_tree():
    if not _TREE:
        _TREE.append(ic.Tree(REPO))
    return _TREE[0]


def gate_problems(jobs):
    """The static half of the input gate: structure, roots, and entry points resolving."""
    bad = []
    for j in jobs:
        entry = PLAN.get(j.name)
        if entry is None:
            continue
        where = f"{j.file}:{j.line}: job {j.name!r}"
        names = [s.name for s in j.steps]
        gated = GATE_STEP in names
        mentions = [s for s in j.steps if "INPUTS_UNCHANGED" in (s.cond or "")]
        if not entry.roots and not entry.never_skip:
            bad.append(f"PLAN[{j.name}] has neither `roots` (its input closure's data) nor "
                       f"`never_skip` (a reason it is never skipped) — decide one")
        if entry.roots and entry.never_skip:
            bad.append(f"PLAN[{j.name}] has both `roots` and `never_skip`; a job is one or the other")
        if entry.never_skip:
            if gated or mentions or any(n in names for n in INFRA):
                bad.append(f"{where} is never skipped ({entry.never_skip}) but carries the "
                           f"input gate — take it out")
            continue
        if not gated:
            bad.append(f"{where} carries no {GATE_STEP!r} step; every job with `roots` is gated")
            continue
        perms = j.permissions if j.permissions is not None else j.wf_permissions
        if perms.get("actions") not in ("read", "write"):
            bad.append(f"{where}: the gate reads the green store, so the job needs "
                       f"`permissions: actions: read`")
        st = j.steps
        if len(st) < 5 or not (st[0].uses or "").startswith("actions/checkout@"):
            bad.append(f"{where}: a gated job starts with the checkout")
        if len(st) < 2 or st[1].name != GATE_STEP:
            bad.append(f"{where}: {GATE_STEP!r} must be the second step, right after checkout")
        else:
            g = st[1]
            if g.cond is not None or g.run != gate_run("gate", j):
                bad.append(f"{where}: {GATE_STEP!r} must run `{gate_run('gate', j)}` with no `if:`")
        if st[-1].name != RECORD_STEP:
            bad.append(f"{where}: {RECORD_STEP!r} must be the last step — a step after it "
                       f"could fail after the inputs were marked green")
        else:
            r = st[-1]
            if not (r.uses or "").startswith(UPLOAD_ARTIFACT) or r.cond != RECORD_IF \
                    or r.with_ != RECORD_WITH:
                bad.append(f"{where}: {RECORD_STEP!r} must be `{UPLOAD_ARTIFACT}` with "
                           f"`if: {RECORD_IF}` and with {RECORD_WITH}")
        if len(st) < 3 or st[-2].name != AUDIT_STEP:
            bad.append(f"{where}: {AUDIT_STEP!r} must be the step before {RECORD_STEP!r}")
        else:
            a = st[-2]
            if a.cond != AUDIT_IF or a.run != gate_run("audit", j):
                bad.append(f"{where}: {AUDIT_STEP!r} must run `{gate_run('audit', j)}` "
                           f"with `if: {AUDIT_IF}`")
        for s in st[2:-2]:
            try:
                ok, _ = split_gate(s.cond, j.name)
            except ParseError as e:
                bad.append(f"{j.file}:{s.line}: step {s.name!r} in {j.name!r}: {e}")
                continue
            if not ok:
                bad.append(f"{j.file}:{s.line}: step {s.name!r} in {j.name!r} lacks the gate's "
                           f"`if: {GATE_IF}` — on a skip it would run against a stale verdict")
        for s in (x for x in st[:2] + st[-2:] if x.name not in INFRA):
            if "INPUTS_UNCHANGED" in (s.cond or ""):
                bad.append(f"{j.file}:{s.line}: step {s.name!r} sits outside the gated span")
        # Every entry point a run block names must resolve, or the closure misses its code.
        mv = j.matrix.get(entry.matrix, [None])[0] if entry.matrix else None
        try:
            cl = closure_of(j, entry, mv, the_tree())
        except Exception as e:      # a closure that cannot be computed is not a pass
            bad.append(f"{where}: its input closure could not be computed: {e}")
            continue
        for sname, tok, why in cl.unresolved:
            bad.append(f"{where} / {sname}: {tok!r} {why} — its input closure cannot include it")
    return bad


# ------------------------------------------------------------- completeness

_INTERP = re.compile(r"\$\{\{\s*([a-z]+)\.([A-Za-z0-9_-]+)\s*\}\}")

# Variables the GitHub runner puts in the environment.  A step that reads one dies
# under `set -u` here, which is how `pipeline`'s Dafny step failed the first time
# --only ran it.  Only those with an honest local equivalent are supplied; anything
# else in this namespace is a completeness ERROR, so a step that starts reading a new
# runner variable is refused rather than failing mid-run with `unbound variable`.
RUNNER_VARS = ("RUNNER_TEMP", "GITHUB_WORKSPACE", "GITHUB_ENV", "GITHUB_PATH",
               "GITHUB_OUTPUT", "GITHUB_STEP_SUMMARY", "GITHUB_EVENT_NAME")
_RUNNER_REF = re.compile(r"\$\{?((?:GITHUB|RUNNER)_[A-Z_]+)\}?")


def runner_env(scratch, weekly=False):
    """The runner-provided variables, pointed at a scratch directory of our own.
    `RUNNER_TEMP` is literally "a temporary directory the runner cleans up", so a
    tempdir here is the same thing rather than a stand-in for it.  GITHUB_EVENT_NAME
    is `schedule` under --weekly, which is the run --weekly stands in for, and `push`
    otherwise, so a step that branches on it takes the same branch CI would."""
    e = dict(os.environ)
    e["GITHUB_EVENT_NAME"] = "schedule" if weekly else "push"
    e["RUNNER_TEMP"] = str(scratch)
    e["GITHUB_WORKSPACE"] = str(REPO)
    for f in ("GITHUB_ENV", "GITHUB_PATH", "GITHUB_OUTPUT", "GITHUB_STEP_SUMMARY"):
        e[f] = str(scratch / f.lower())
    e["CI"] = "true"
    return e


def interpolate(text, env, matrix_dim=None, matrix_val=None):
    """Resolve ${{ env.X }} and ${{ matrix.X }}.  Anything else is refused: a step
    whose text still carries an unresolved expression must not be run as if it
    were the CI command."""
    def sub(m):
        ns, key = m.group(1), m.group(2)
        if ns == "env" and key in env:
            return env[key]
        if ns == "matrix" and key == matrix_dim:
            return matrix_val
        raise ParseError(f"cannot resolve ${{{{ {ns}.{key} }}}}")
    return _INTERP.sub(sub, text)


def completeness(env, jobs):
    """Every job planned, every plan entry real, every run step decided.  Returns
    a list of problems; empty means this script still stands in for CI."""
    bad = []
    on_disk = {j.name: j for j in jobs}
    for name in sorted(set(on_disk) - set(PLAN)):
        j = on_disk[name]
        bad.append(f"{j.file}:{j.line}: job {name!r} is in CI and unknown to bin/verify-repo — "
                   f"add it to PLAN (run it, or skip it with a reason)")
    for name in sorted(set(PLAN) - set(on_disk)):
        bad.append(f"PLAN names job {name!r}, which no workflow defines")

    for name, entry in sorted(PLAN.items()):
        j = on_disk.get(name)
        if j is None:
            continue
        if entry.unless and entry.unless[0] not in PREDICATES:
            bad.append(f"PLAN[{name}].unless names predicate {entry.unless[0]!r}, "
                       f"which does not exist")
        # A job blocked on this machine is still fully PLANNED: its steps are checked
        # here so the declaration cannot rot while the platform excuses the run.
        step_names = [s.name for s in j.steps]
        for key in sorted(entry.skips):
            if key not in step_names:
                bad.append(f"PLAN[{name}].skips names step {key!r}, which the job no longer has")
        for s in j.steps:
            if s.kind == "uses" or s.name in entry.skips or _is_infra(s):
                continue
            if s.name is None:
                bad.append(f"{j.file}:{s.line}: unnamed `run:` step in job {name!r} — "
                           f"this script addresses steps by name")
                continue
            try:
                _, residual = split_gate(s.cond, name)
            except ParseError as e:
                bad.append(f"{j.file}:{s.line}: step {s.name!r} in {name!r}: {e}")
                continue
            if residual and s.name not in entry.skips:
                bad.append(f"{j.file}:{s.line}: step {s.name!r} in {name!r} carries `if: {residual}` "
                           f"and is not in PLAN[{name}].skips — decide it explicitly")
        if entry.matrix and entry.matrix not in j.matrix:
            bad.append(f"PLAN[{name}] expands matrix {entry.matrix!r}, which the job does not define")
            continue
        # Every step we would run must interpolate NOW.  `${{ secrets.x }}` or a
        # `${{ env.X }}` with no X resolves to nothing useful, and a step run with a
        # hole in it is not the CI command however green it exits.
        mv = j.matrix.get(entry.matrix, [None])[0] if entry.matrix else None
        for s in j.steps:
            if s.kind == "uses" or s.name in entry.skips or s.run is None or _is_infra(s):
                continue
            try:
                interpolate(s.run, j.env, entry.matrix, mv)
            except ParseError as e:
                bad.append(f"{j.file}:{s.line}: step {s.name!r} in {name!r}: {e}")
            for v in sorted(set(_RUNNER_REF.findall(s.run)) - set(RUNNER_VARS)):
                bad.append(f"{j.file}:{s.line}: step {s.name!r} in {name!r} reads ${v}, "
                           f"which the runner provides and bin/verify-repo does not — "
                           f"add it to RUNNER_VARS with a local equivalent, or skip the step")
    bad += matrix_membership_problems(on_disk)
    bad += deploy_problems(jobs)
    bad += pin_problems(jobs)
    bad += gate_problems(jobs)
    # split_gate is asked twice of one step (gate_problems and the `if:` rule), so a
    # malformed gate would be reported twice; once is the finding.
    return list(dict.fromkeys(bad))


def deploy_problems(jobs):
    """The Pages deploy must wait for EVERY other job in its workflow. GitHub does not check a
    `needs:` list is complete, so a job added to verify.yml and left out of it would let a page
    go live before that job's gate had passed — the one thing deploying from CI is for."""
    bad = []
    for d in (j for j in jobs if j.name == "deploy"):
        others = {j.name for j in jobs if j.file == d.file and j.name != "deploy"}
        for name in sorted(others - set(d.needs)):
            bad.append(f"{d.file}:{d.line}: job 'deploy' does not need {name!r} — the site "
                       f"would publish before that gate passed")
        for name in sorted(set(d.needs) - others):
            bad.append(f"{d.file}:{d.line}: job 'deploy' needs {name!r}, which {d.file} "
                       f"does not define")
    return bad


# The bun pin lives in two files (verify.yml and dual-backed.yml), and `load()` takes the
# UNION of the workflows' `env:` maps, so a value that differs between files would be resolved
# by whichever file sorts last — and `tool_versions` would compare the local bun against that
# one while the other file's jobs ran something else. Both directions are refused here: a
# top-level env key two files define must have one value, and every setup-bun step must read
# the pin rather than carry a literal (a literal is a second copy of the pin, which is how the
# four `'1.2.4'`s this replaced came to exist). Nothing else catches either: the steps are
# `uses:` steps, which no other rule here inspects.
SETUP_BUN = "oven-sh/setup-bun@"
BUN_PIN = "${{ env.BUN_VERSION }}"


def pin_problems(jobs):
    bad, seen = [], {}
    for j in jobs:
        for k, v in j.env.items():
            seen.setdefault(k, {})[j.file] = v
    for k, by_file in sorted(seen.items()):
        if len(set(by_file.values())) > 1:
            bad.append(f"top-level env {k} disagrees between workflows: " + ", ".join(
                f"{f}={v}" for f, v in sorted(by_file.items())))
    for j in jobs:
        for s in j.steps:
            if not (s.uses or "").startswith(SETUP_BUN):
                continue
            got = s.with_.get("bun-version")
            if got != BUN_PIN:
                bad.append(f"{j.file}:{s.line}: setup-bun step in {j.name!r} has "
                           f"bun-version {got!r}; it must read {BUN_PIN}")
            elif "BUN_VERSION" not in j.env:
                bad.append(f"{j.file}:{s.line}: setup-bun step in {j.name!r} reads "
                           f"BUN_VERSION, which {j.file} does not define in its top-level env")
    return bad


# `verify` and `pipeline` are matrices over HAND-WRITTEN lists in the workflow, and until
# 2026-08-25 nothing compared either list against the sessions on disk. That is the failure
# this whole script exists to stop, arriving one level down from where it was being watched:
# the completeness check above asks whether every JOB is planned, and both were, while the
# `verify` matrix named eight artefacts and the `pipeline` matrix seven — with a ninth and an
# eighth sitting in `sessions/`. CI went green over a corpus that was missing the session the
# push was about, and `--sessions` reproduced the same narrow run locally, because it expands
# "the workflow's own lists" and those lists were the thing that was wrong.
#
# So this is the same rule `assertCorpusIsEverySessionOnDisk` enforces for the TypeScript
# corpus and `check_preregistrations` for its session classification, applied to the two
# matrices: BOTH directions are errors. A session on disk that no matrix entry names would
# silently narrow CI; an entry naming a directory that does not exist would fail every run.
MATRIX_ON_DISK = {
    # job -> (dimension, how a session directory maps to an entry, what an entry must contain)
    "verify": ("artefact", lambda d: f"sessions/{d}/report", ("facts.json",)),
    "pipeline": ("session", lambda d: d, ("report/facts.json",)),
}


def matrix_membership_problems(jobs_by_name):
    bad = []
    sessions_dir = REPO / "sessions"
    if not sessions_dir.is_dir():
        return [f"{sessions_dir} does not exist, so the matrices cannot be checked against it"]
    on_disk = sorted(d.name for d in sessions_dir.iterdir()
                     if d.is_dir() and (d / "report" / "facts.json").exists())
    if not on_disk:
        return ["no session on disk carries report/facts.json — an empty corpus would make "
                "every membership check below vacuous"]
    for job, (dim, to_entry, _) in MATRIX_ON_DISK.items():
        j = jobs_by_name.get(job)
        if j is None or dim not in j.matrix:
            bad.append(f"{job}: no {dim!r} matrix to check against sessions/")
            continue
        listed = list(j.matrix[dim])
        want = [to_entry(d) for d in on_disk]
        for w, d in zip(want, on_disk):
            if w not in listed:
                bad.append(f"{j.file}: the {job!r} matrix does not name {w!r}, but "
                           f"sessions/{d} is on disk. A session missing from a matrix makes "
                           f"CI narrower than the corpus while every job it does run goes green")
        # ...and the other direction, restricted to the entries this rule generates: the
        # `verify` matrix legitimately carries sessions/2026-07-24/proof, which is a second
        # artefact of one session and not a session, so only session-shaped entries are checked.
        for e in listed:
            if e in want:
                continue
            m = re.fullmatch(r"sessions/(\d{4}-\d{2}-\d{2})/report", e) if dim == "artefact" \
                else re.fullmatch(r"\d{4}-\d{2}-\d{2}", e)
            if m and (m.group(1) if dim == "artefact" else e) not in on_disk:
                bad.append(f"{j.file}: the {job!r} matrix names {e!r}, which is not a session "
                           f"on disk carrying report/facts.json")
    return bad


# ------------------------------------------------------------------ execution

def run_step(step, env, cwd, matrix=(None, None), dry=False, envvars=None):
    cmd = interpolate(step.run, env, *matrix)
    # CI's default shell is `bash -e {0}`; the run bodies that need more set it
    # themselves on their first line.
    if dry:
        return True, cmd
    r = subprocess.run(["bash", "-e", "-c", cmd], cwd=cwd, env=envvars)
    return r.returncode == 0, cmd


def tool_versions(env):
    """(available, divergences) — a pinned tool whose local version is not CI's is
    reported, never silently accepted."""
    have, diverge = {}, []
    for tool, key in TOOLCHAIN.items():
        path = shutil.which(tool)
        have[tool] = path
        if not path or key not in env:
            continue
        try:
            out = subprocess.run([tool, "--version"], capture_output=True, text=True,
                                 timeout=60).stdout
        except Exception:
            continue
        want = env[key]
        if want not in out:
            diverge.append(f"{tool}: CI pins {want}, local is {out.strip().splitlines()[0]}")
    for t in ("jq", "nix", "sha256sum"):
        have[t] = shutil.which(t)
    return have, diverge


def session_of(value):
    """The session date a matrix value belongs to, or None.  `verify` entries are
    artefact directories (`sessions/<date>/report`, `sessions/<date>/proof`), `pipeline`
    entries are bare dates, so a date matches its own entry in either matrix."""
    m = re.fullmatch(r"(\d{4}-\d{2}-\d{2})", value) or \
        re.match(r"sessions/(\d{4}-\d{2}-\d{2})/", value)
    return m.group(1) if m else None


def matrix_combos(entry, job, args):
    """(run, left out) for one matrix job.  With --session, only the entries for those
    dates run, and every other entry is returned so the summary can name it: a narrowed
    run that did not say what it left out would read as the full matrix."""
    vals = list(job.matrix[entry.matrix])
    if not args.session:
        return vals, []
    keep = [v for v in vals if session_of(v) in args.session]
    return keep, [v for v in vals if v not in keep]


def selected(entry, args, name=None):
    # --only is the "CI went red on X, reproduce X" path, and it overrides the tiers
    # outright: naming a job is a decision, so it does not also need the right flag.
    if args.only:
        return name in args.only
    if entry.tier == SESSIONS:
        return args.sessions or bool(args.session)
    if entry.tier == WEEKLY:
        return args.weekly
    if entry.tier == SLOW:
        return not args.fast
    return True


class Unit:
    """One job run, or one matrix entry of one."""

    def __init__(self, name, entry, job, dim, val):
        self.name, self.entry, self.job, self.dim, self.val = name, entry, job, dim, val
        self.label = name if val is None else f"{name}[{val}]"
        # The `verify` matrix is ONE serial lane under --jobs: its entries share the Dafny
        # toolchain's caches and were never written to run beside each other.  Every other
        # unit is its own lane.
        self.lane = name if name == "verify" else self.label
        self.status, self.output, self.why, self.steps = None, "", "", []
        self.digest = None


def _safe(label):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", label).strip("_")


def _closure_for(u):
    return ic.closure(u.job, u.entry, interpolate, u.dim, u.val, the_tree())


def run_unit(u, args, scratch, stream):
    """Run one unit's steps.  `stream` prints as it goes (serial); otherwise output is
    buffered and returned whole, so parallel units never interleave."""
    buf = []

    def say(text, err=False):
        if stream:
            print(text, file=sys.stderr if err else sys.stdout, flush=True)
        else:
            buf.append(text)

    # A scratch RUNNER_TEMP of the unit's own: two units side by side must not share one,
    # and CI gives every job a fresh one anyway.
    temp = scratch / _safe(u.label)
    temp.mkdir(parents=True, exist_ok=True)
    shellenv = runner_env(temp, args.weekly)
    audit = bool(args.audit_inputs) and not u.entry.never_skip
    opened, listed = set(), set()
    say(f"\n== {u.label} ==")
    t0 = time.monotonic()
    ok = True
    for i, st in enumerate(u.job.steps):
        if st.kind == "uses" or _is_infra(st):
            continue
        if st.name in u.entry.skips and not (args.weekly and st.name in WEEKLY_STEP_SKIPS):
            continue
        cwd = REPO / st.workdir if st.workdir else REPO
        say(f"-- {st.name}" + (f"  (in {st.workdir})" if st.workdir else ""))
        t1 = time.monotonic()
        try:
            cmd = interpolate(st.run, u.job.env, u.dim, u.val)
        except ParseError as e:
            say(f"FAIL  {u.label} / {st.name}: {e}", err=True)
            ok = False
            break
        if args.dry_run:
            say("\n".join("     " + l for l in cmd.rstrip().split("\n")))
            continue
        argv = ["bash", "-e", "-c", cmd]
        log = None
        if audit:
            log = temp / f"strace-{i}.log"
            argv = ["strace", "-f", "-qq", "-o", str(log),
                    "-e", "trace=openat,open,execve", *argv]
        if stream:
            r = subprocess.run(argv, cwd=cwd, env=shellenv)
        else:
            r = subprocess.run(argv, cwd=cwd, env=shellenv, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, errors="replace")
            buf.append(r.stdout.rstrip("\n"))
        u.steps.append((st.name, round(time.monotonic() - t1, 3)))
        if log is not None and log.exists():
            o, l = ic.parse_strace(log.read_text(errors="replace").splitlines(), REPO, cwd)
            opened |= o
            listed |= l
        if r.returncode:
            say(f"FAIL  {u.label} / {st.name}", err=True)
            ok = False
            break
    if ok and audit and not args.dry_run:
        cl = _closure_for(u)
        bad = ic.audit(cl, the_tree(), opened, listed)
        say(f"-- audit: {len(opened)} files opened, {len(listed)} directories listed, "
            f"{len(bad)} problems")
        for b in bad:
            say(f"FAIL  {u.label} / input closure: {b}", err=True)
        if bad:
            ok, u.why = False, "opened files outside its input closure"
    u.seconds = round(time.monotonic() - t0, 3)
    u.status = "ok" if ok else "fail"
    u.output = "\n".join(buf)
    return u


def execute(env, jobs, args):
    by_name = {j.name: j for j in jobs}
    have, diverge = tool_versions(env)
    scratch = Path(tempfile.mkdtemp(prefix="verify-repo-"))
    ran, failed, skipped, uncovered, unchanged = [], [], [], [], []
    changed = args.changed is not None
    forced = set(args.changed or []) - {""}

    order = [n for n in PLAN if n in by_name]
    order.sort(key=lambda n: ({FAST: 0, DEFAULT: 1, SLOW: 2, WEEKLY: 3, SESSIONS: 4}
                              .get(PLAN[n].tier, 5), n))

    units = []
    for name in order:
        entry, job = PLAN[name], by_name[name]
        if not selected(entry, args, name):
            skipped.append((name, f"tier {entry.tier}, not selected"))
            continue
        blocked = entry.blocked()
        if blocked:
            skipped.append((name, blocked))
            continue
        missing = [t for t in entry.needs if not have.get(t)]
        if missing:
            print(f"FAIL  {name} — not on PATH: {', '.join(missing)}", file=sys.stderr)
            failed.append(name)
            continue
        if args.audit_inputs and not shutil.which("strace"):
            print("FAIL  --audit-inputs needs strace on PATH", file=sys.stderr)
            return 1
        combos = [(None, None)]
        if entry.matrix:
            keep, left = matrix_combos(entry, job, args)
            combos = [(entry.matrix, v) for v in keep]
            uncovered += [f"{name}[{v}]" for v in left]
        units += [Unit(name, entry, job, dim, val) for dim, val in combos]

    # --changed: a unit whose input hash was green HERE before is not run.  The hash is
    # taken before anything runs, so what is recorded on a pass is the input it ran on.
    green = ic.green_dir() if changed else None
    todo = []
    for u in units:
        if changed and not u.entry.never_skip:
            u.digest = _closure_for(u).digest(the_tree())
            mark = green / ic.artifact_name(u.name, u.val, u.digest)
            u.was_green = mark.exists()
            if u.was_green and u.name not in forced:
                unchanged.append(u.label)
                continue
        todo.append(u)

    lanes = {}
    for u in todo:
        lanes.setdefault(u.lane, []).append(u)
    stream = args.jobs <= 1
    lock = threading.Lock()
    t0 = time.monotonic()

    def run_lane(us):
        for u in us:
            run_unit(u, args, scratch, stream)
            if not stream:
                with lock:
                    print(u.output, flush=True)
        return us

    if stream:
        for us in lanes.values():
            run_lane(us)
    else:
        with ThreadPoolExecutor(max_workers=args.jobs) as pool:
            list(pool.map(run_lane, lanes.values()))
    wall = round(time.monotonic() - t0, 3)

    for u in todo:
        (ran if u.status == "ok" else failed).append(u.label)
        if changed and u.digest and u.status == "ok" and not args.dry_run:
            green.mkdir(parents=True, exist_ok=True)
            (green / ic.artifact_name(u.name, u.val, u.digest)).write_text(u.digest + "\n")

    print("\n" + "=" * 72)
    print(f"ran {len(ran)}, failed {len(failed)}"
          + (f", unchanged {len(unchanged)}" if changed else ""))
    for n in sorted(ran):
        print(f"  ok   {n}")
    for n in sorted(failed):
        print(f"  FAIL {n}")
    for u in todo:
        if u.name in forced and getattr(u, "was_green", False) and u.status != "ok":
            print(f"  !!   {u.label} was green on these inputs before and is red now")
    # Everything NOT run is named.  A run that quietly covered less than it claims
    # is the failure this tool exists to stop.
    for n in sorted(unchanged):
        print(f"  --   {n}: skipped: inputs unchanged (green here before)")
    for n, why in skipped:
        print(f"  --   {n}: {why}")
    if uncovered:
        print(f"  --   {len(uncovered)} matrix entries NOT run (--session "
              f"{' '.join(sorted(args.session))}):")
        for n in uncovered:
            print(f"  --     {n}")
    for name in order:
        e = PLAN[name]
        if selected(e, args, name) and not e.blocked():
            for s, why in sorted(e.skips.items()):
                if not (args.weekly and s in WEEKLY_STEP_SKIPS):
                    print(f"  --   {name} / {s}: {why}")
    for d in diverge:
        print(f"  !!   toolchain divergence — {d}")
    if args.timings:
        Path(args.timings).write_text(json.dumps(
            {"jobs": args.jobs, "wall_seconds": wall,
             "units": {u.label: {"seconds": u.seconds, "status": u.status,
                                 "steps": dict(u.steps)} for u in todo}},
            indent=1, sort_keys=True) + "\n")
        print(f"  --   timings written to {args.timings}")
    shutil.rmtree(scratch, ignore_errors=True)
    if not args.sessions and not args.session and not args.only:
        print("  --   per-session gates: bin/verify-session <artefact-dir> "
              "(or bin/verify-repo --sessions)")
    return 1 if failed else 0


# ------------------------------------------------------------------- selftest

DOCS_STEP = "      - name: Check a second render of the site is byte-identical\n"
GATE_LINE = "        if: env.INPUTS_UNCHANGED != '1'\n"


def _corrupt(kind, texts):
    t = dict(texts)
    v, d = "verify.yml", "dual-backed.yml"
    # The three matrix-membership mutants. They are the ones the completeness check could not
    # see until 2026-08-25: every JOB stayed planned while the two matrices named a corpus
    # smaller than `sessions/`, so CI ran green over a session it never looked at.
    if kind == "a session dropped from the verify matrix":
        # No `(?=\n    steps:)` lookahead, for the reason spelled out under the pipeline
        # matrix below: an anchor pinned to the entry that happens to sit LAST stops
        # corrupting the moment anything is appended after it. It did, when
        # `subsets/2026-09-18-onform/report` was added to this matrix — the lookahead
        # matched nothing, the mutant mutated nothing, and `_corrupt`'s assertion is what
        # turned that into a red build instead of a selftest quietly proving nothing.
        # Dropping ANY session entry is the corruption under test; which one is irrelevant,
        # because the completeness check rejects a matrix naming fewer sessions than disk.
        t[v] = re.sub(r"\n *- sessions/\d{4}-\d{2}-\d{2}/report\b", "", t[v], count=1)
    elif kind == "a session dropped from the pipeline matrix":
        # `,\s*` and not `, `: the matrix is a YAML flow sequence that wraps when it grows, so
        # the last entry sits on its own line as often as not. Pinned to a literal space, this
        # corruption silently stopped corrupting when 2026-09-11 pushed the list onto a third
        # line — and a mutation that changes nothing is a selftest that proves nothing. The
        # assertion in `_corrupt` is what turned that into a red build rather than a quiet pass.
        t[v] = re.sub(r",\s*'\d{4}-\d{2}-\d{2}'\]", "]", t[v], count=1)
    elif kind == "a matrix names a session that is not on disk":
        t[v] = re.sub(r"('\d{4}-\d{2}-\d{2}')\]", r"\1, '1999-01-01']", t[v], count=1)
    elif kind == "job added to CI":
        t[v] = t[v] + "\n  brand-new-job:\n    runs-on: ubuntu-24.04\n    steps:\n" \
                      "      - name: Do a thing\n        run: echo hi\n"
    elif kind == "job removed from CI":
        # Anchored on the job-id line alone, not on the lines after it: the job's keys
        # (`runs-on`, `timeout-minutes`, ...) are free to change, and an anchor that spelled
        # them stopped corrupting the day `timeout-minutes` was added after `runs-on`.
        t[v] = re.sub(r"\n  docs:\n", "\n  docs-renamed:\n", t[v], count=1)
    elif kind == "step added carrying an unresolvable expression":
        # Gated like its neighbours, so the ONLY thing wrong with it is the expression.
        t[v] = t[v].replace(DOCS_STEP,
                            "      - name: Newly added step\n" + GATE_LINE +
                            "        run: echo ${{ secrets.TOKEN }}\n" + DOCS_STEP)
    elif kind == "skipped step renamed":
        t[v] = t[v].replace("      - name: Mutation-test the spec",
                            "      - name: Mutation-test the spec (renamed)")
    elif kind == "conditional step added undeclared":
        # The gate is stripped before the "every `if:` is decided" rule, so the residual
        # condition is what must be caught, exactly as before the gate existed.
        t[v] = t[v].replace(DOCS_STEP + GATE_LINE,
                            DOCS_STEP + "        if: env.INPUTS_UNCHANGED != '1' && "
                            "(github.event_name == 'schedule')\n")
    elif kind == "step reads an unsupplied runner variable":
        t[v] = t[v].replace(DOCS_STEP + GATE_LINE +
                            "        run: python3 bin/build-docs --check --out _site\n",
                            DOCS_STEP + GATE_LINE +
                            "        run: python3 bin/build-docs --check --out _site \"$RUNNER_ARCH\"\n")
    # ---- the input gate (yachi's decision of 2026-11-17)
    elif kind == "a gated step loses the gate's if":
        t[v] = t[v].replace(DOCS_STEP + GATE_LINE, DOCS_STEP)
    elif kind == "a gate of another shape":
        t[v] = t[v].replace(DOCS_STEP + GATE_LINE,
                            DOCS_STEP + "        if: env.INPUTS_UNCHANGED == '1'\n")
    elif kind == "the main-push render form on a job that is not docs":
        t[v] = t[v].replace(
            "      - name: Check the R analysis is current and every figure it feeds agrees "
            "(and that the gate can fail)\n" + GATE_LINE,
            "      - name: Check the R analysis is current and every figure it feeds agrees "
            "(and that the gate can fail)\n" + "        if: " + MAIN_PUSH_IF + "\n")
    elif kind == "a never-skipped job carries the gate":
        t[v] = t[v].replace(
            "      - name: Check bin/verify-repo still knows every job and step",
            "      - name: Input gate\n        run: python3 bin/input-hash gate workflow-plan\n\n"
            "      - name: Check bin/verify-repo still knows every job and step")
    elif kind == "a step after Record green inputs":
        t[d] = t[d].rstrip("\n") + "\n\n      - name: Late step\n" + GATE_LINE + \
            "        run: echo late\n"
    elif kind == "Record green inputs loses its success() guard":
        t[d] = t[d].replace("        if: success() && env.INPUTS_UNCHANGED != '1'\n",
                            "        if: env.INPUTS_UNCHANGED != '1'\n")
    elif kind == "the audit step is dropped":
        t[d] = re.sub(r"      - name: Audit the input closure\n.*?\n\n", "", t[d],
                      count=1, flags=re.S)
    elif kind == "a gated workflow loses actions: read":
        t[d] = re.sub(r"\n  actions: read[^\n]*", "", t[d], count=1)
    elif kind == "an entry point names no file":
        t[v] = t[v].replace("python3 -m pipeline.check_rate_records --selftest",
                            "python3 -m pipeline.check_rate_recordz --selftest")
    elif kind == "deploy leaves a job out of its needs":
        t[v] = t[v].replace("needs: [verify, pipeline, ", "needs: [verify, ", 1)
    elif kind == "unknown job key":
        t[d] = t[d].replace("  manifest:\n    runs-on:", "  manifest:\n    runz-on:")
    elif kind == "unknown step key":
        t[d] = t[d].replace("      - name: Setup Bun\n" + GATE_LINE + "        uses:",
                            "      - name: Setup Bun\n" + GATE_LINE + "        usez:")
    elif kind == "a setup-bun step pins a literal version":
        t[d] = t[d].replace("          bun-version: ${{ env.BUN_VERSION }}",
                            "          bun-version: '1.4.2'")
    elif kind == "the bun pin disagrees between workflows":
        t[d] = re.sub(r"\n  BUN_VERSION: *\S+", "\n  BUN_VERSION: 9.9.9", t[d], count=1)
    elif kind == "content after the jobs block":
        t[d] = t[d] + "\nafterwards: true\n"
    elif kind == "folded block scalar":
        t[d] = t[d].replace("        run: bun cross-extract.mjs --check",
                            "        run: >\n          bun cross-extract.mjs --check")
    else:
        raise AssertionError(kind)
    if t == texts:
        raise AssertionError(f"corruption {kind!r} changed nothing — its anchor moved")
    return t


def _load_texts(texts):
    """Scan a set of workflow texts as if they were the committed ones."""
    global WORKFLOWS
    with tempfile.TemporaryDirectory() as td:
        d = Path(td)
        for n, body in texts.items():
            (d / n).write_text(body)
        old, WORKFLOWS = WORKFLOWS, d
        try:
            return load()
        finally:
            WORKFLOWS = old


def _check_texts(texts):
    """Parse + completeness over a set of workflow texts.  Returns problems."""
    return completeness(*_load_texts(texts))


def selftest():
    texts = {p.name: p.read_text() for p in sorted(WORKFLOWS.glob("*.yml"))}
    planted = failures = 0

    # Control 1 — the committed workflows parse and this script is complete for them.
    problems = _check_texts(texts)
    if problems:
        print("CONTROL FAILED — the committed workflows are not fully planned:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        return 1

    # Control 2 — PyYAML, when importable, is the second implementation.  It must
    # agree on job ids, step names and the text of every `run:` block.
    try:
        import yaml
    except ImportError:
        print("  --   PyYAML not importable; the oracle control did not run")
    else:
        env, jobs = load()
        mine = {(j.file, j.name): [(s.name, s.uses, s.run) for s in j.steps] for j in jobs}
        theirs = {}
        for p in sorted(WORKFLOWS.glob("*.yml")):
            for name, body in yaml.safe_load(p.read_text())["jobs"].items():
                theirs[(p.name, name)] = [
                    (s.get("name"), s.get("uses"),
                     s["run"] if "run" in s and "\n" in s["run"] else
                     (s["run"].strip() if "run" in s else None))
                    for s in body.get("steps", [])]
        if set(mine) != set(theirs):
            print(f"ORACLE FAILED — job sets differ: "
                  f"{set(mine) ^ set(theirs)}", file=sys.stderr)
            return 1
        for k in sorted(mine):
            if mine[k] != theirs[k]:
                for a, b in zip(mine[k], theirs[k]):
                    if a != b:
                        print(f"ORACLE FAILED — {k} step {a[0]!r}:\n"
                              f"  scanner: {a!r}\n  pyyaml : {b!r}", file=sys.stderr)
                        return 1
                print(f"ORACLE FAILED — {k} step count "
                      f"{len(mine[k])} vs {len(theirs[k])}", file=sys.stderr)
                return 1
        print(f"  ok   PyYAML oracle agrees on {len(mine)} jobs, "
              f"{sum(len(v) for v in mine.values())} steps")

    # Control 3 — every matrix this script expands is non-empty, and the two known
    # ones still hold the sessions on disk.  A matrix read as empty would make
    # `--sessions` a silent no-op.
    env, jobs = load()
    for j in jobs:
        for dim, vals in j.matrix.items():
            if not vals:
                print(f"CONTROL FAILED — matrix {j.name}.{dim} scanned empty", file=sys.stderr)
                return 1

    # Control 4 — DERIVATION, not copying.  A plain new `run:` step in a job we run
    # must be absorbed silently and end up in the executed set.  If this control
    # ever fails, the command list has become a copy and the whole argument for
    # this script's shape is gone.
    # Since the input gate, "plain" means plain for a gated job: a run step carrying the
    # gate's `if:` and nothing else.  (Without it the step is a planted corruption below.)
    added = dict(texts)
    added["verify.yml"] = added["verify.yml"].replace(
        DOCS_STEP, "      - name: Newly added step\n" + GATE_LINE + "        run: echo hi\n\n"
        + DOCS_STEP)
    if added == texts:
        print("CONTROL FAILED — the absorption control's anchor moved", file=sys.stderr)
        return 1
    if _check_texts(added):
        print("CONTROL FAILED — a plain new step was rejected instead of absorbed",
              file=sys.stderr)
        return 1
    _, js = _load_texts(added)
    names = [st.name for j in js if j.name == "docs" for st in j.steps]
    if "Newly added step" not in names:
        print(f"CONTROL FAILED — the new step is not in the docs plan: {names}", file=sys.stderr)
        return 1
    print("  ok   a plain new run step is absorbed, not rejected")

    # Control 5 — --session partitions each matrix.  Every entry must belong to exactly
    # one session date, so that the run plus the summary's "NOT run" list is always the
    # whole matrix.  An entry `session_of` cannot place (a renamed artefact layout) would
    # be selectable by no --session and named by no summary line.
    class _A:
        pass
    for job, (dim, to_entry, _) in MATRIX_ON_DISK.items():
        j = next(x for x in jobs if x.name == job)
        vals = j.matrix[dim]
        orphans = [v for v in vals if session_of(v) is None]
        if orphans:
            print(f"CONTROL FAILED — {job} entries no --session can select: {orphans}",
                  file=sys.stderr)
            return 1
        for d in sorted({session_of(v) for v in vals}):
            a = _A()
            a.session = [d]
            keep, left = matrix_combos(PLAN[job], j, a)
            if sorted(keep + left) != sorted(vals) or to_entry(d) not in keep:
                print(f"CONTROL FAILED — --session {d} does not partition {job}: {keep}",
                      file=sys.stderr)
                return 1
    print("  ok   --session partitions both matrices by date")

    # The planted corruptions.  Each must be REJECTED — by the scanner or by the
    # completeness check; which one does not matter, going green does.
    for kind in ("job added to CI", "job removed from CI",
                 "step added carrying an unresolvable expression",
                 "skipped step renamed", "conditional step added undeclared",
                 "step reads an unsupplied runner variable", "unknown job key", "unknown step key", "content after the jobs block",
                 "a setup-bun step pins a literal version",
                 "the bun pin disagrees between workflows",
                 "deploy leaves a job out of its needs",
                 "folded block scalar",
                 "a session dropped from the verify matrix",
                 "a session dropped from the pipeline matrix",
                 "a matrix names a session that is not on disk",
                 "a gated step loses the gate's if", "a gate of another shape",
                 "the main-push render form on a job that is not docs",
                 "a never-skipped job carries the gate", "a step after Record green inputs",
                 "Record green inputs loses its success() guard", "the audit step is dropped",
                 "a gated workflow loses actions: read", "an entry point names no file"):
        planted += 1
        bad = _corrupt(kind, texts)
        try:
            problems = _check_texts(bad)
            caught = bool(problems)
        except ParseError:
            caught = True
        if caught:
            print(f"  ok   caught: {kind}")
        else:
            print(f"  FAIL not caught: {kind}", file=sys.stderr)
            failures += 1

    # PLAN-level corruptions: a job whose entry decides neither roots nor never_skip, and one
    # deciding both.  They edit PLAN, not a workflow, so they are planted by swapping entries.
    for kind, name, change in (
            ("a job has neither roots nor never_skip", "rounding", dict(roots=())),
            ("a job has both roots and never_skip", "rounding", dict(never_skip="planted")),
            ("a never-skipped job is given roots", "workflow-plan", dict(roots=("bin/",)))):
        planted += 1
        old = PLAN[name]
        PLAN[name] = copy.copy(old)
        PLAN[name].__dict__.update(change)
        try:
            caught = bool(_check_texts(texts))
        except ParseError:
            caught = True
        finally:
            PLAN[name] = old
        print(f"  {'ok  ' if caught else 'FAIL'} {'caught' if caught else 'not caught'}: {kind}",
              file=sys.stdout if caught else sys.stderr)
        failures += not caught

    print(f"\n{planted} planted corruptions, {planted - failures} caught")
    return 1 if failures else 0


# ----------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--fast", action="store_true", help="omit the slow tier")
    ap.add_argument("--weekly", action="store_true", help="add the schedule-only jobs and steps")
    ap.add_argument("--sessions", action="store_true", help="add the two per-session matrices")
    ap.add_argument("--session", action="append", metavar="DATE",
                    help="run both matrices for this session only (repeatable); the "
                         "summary names every matrix entry left out")
    ap.add_argument("--only", action="append", metavar="JOB",
                    help="run only these jobs, whatever their tier (repeatable)")
    ap.add_argument("--check", action="store_true", help="completeness only; run nothing")
    ap.add_argument("--list", action="store_true", help="print the plan and exit")
    ap.add_argument("--dry-run", action="store_true", help="print each command instead of running it")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--jobs", type=int, default=1, metavar="N",
                    help="run N independent jobs at once (the verify matrix is one serial "
                         "lane); each job's output is printed whole when it ends")
    ap.add_argument("--changed", nargs="?", const="", default=None, metavar="JOB[,JOB]",
                    help="skip a job whose input hash was green here before; name jobs to "
                         "run them anyway and report if one went red")
    ap.add_argument("--audit-inputs", action="store_true",
                    help="run each step under strace and fail on a tracked file opened "
                         "outside the job's input closure (Linux)")
    ap.add_argument("--timings", metavar="FILE", help="write per-job and per-step wall seconds")
    args = ap.parse_args()
    if args.changed is not None:
        args.changed = [x for x in args.changed.split(",")] if args.changed else []

    if args.selftest:
        return selftest()

    env, jobs = load()
    problems = completeness(env, jobs)
    if args.only:
        unknown = sorted(set(args.only) - set(PLAN))
        if unknown:
            problems += [f"--only names {n!r}, which is not a job" for n in unknown]
    if args.session:
        by_name = {j.name: j for j in jobs}
        for d in args.session:
            for job, (dim, _, _) in MATRIX_ON_DISK.items():
                j = by_name.get(job)
                if j is None or not any(session_of(v) == d for v in j.matrix.get(dim, [])):
                    problems.append(f"--session {d}: the {job!r} matrix has no entry for it")
    if problems:
        print("bin/verify-repo no longer stands in for CI:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        return 1
    if args.check:
        print(f"ok — {len(jobs)} jobs across "
              f"{len(list(WORKFLOWS.glob('*.yml')))} workflows, all planned")
        return 0

    if args.list:
        for name in sorted(PLAN):
            e = PLAN[name]
            tier = f"tier={e.tier}" + (f" matrix={e.matrix}" if e.matrix else "")
            if e.unless:
                tier += f"  unless {e.unless[0]}: {e.unless[1]}"
            print(f"{name:22} {tier}")
            for s, why in sorted(e.skips.items()):
                print(f"{'':22}   -- {s}: {why}")
        return 0

    return execute(env, jobs, args)


if __name__ == "__main__":
    sys.exit(main())
