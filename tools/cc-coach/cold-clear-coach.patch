+// COACH PATCH: the Monte-Carlo leaf choice drew from the unseeded thread rng, so every search was
+// a fresh random sample and no result reproduced. A thread-local SEEDED rng, reseeded by the caller
+// per search, makes a (position, budget, seed) triple deterministic.
+thread_local! {
+    static COACH_RNG: std::cell::RefCell<rand::rngs::StdRng> = std::cell::RefCell::new(rand::rngs::StdRng::seed_from_u64(0));
