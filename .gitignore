# QA / tooling artefacts — never part of the repo
.playwright-cli/
.playwright/
**/shots/
__pycache__/
*.pyc

# archives of the raw replay drops
*.zip

# OS noise
.DS_Store
Thumbs.db

# local Dafny scratch
*.dfy.tmp
*.bak

# derived simulation cache — regenerate with pipeline/sim/pairs.ts.
# The pattern must follow the CODE, not the sessions: the cache is written beside pairs.ts, so
# when the simulator moved to pipeline/sim a sessions-only pattern silently stopped matching and
# a 200 KB derived cache would have been committed as if it were source. The old pattern stays
# so an existing checkout's leftover cache is still ignored.
pipeline/sim/pairs-cache.json
sessions/*/sim/pairs-cache.json
