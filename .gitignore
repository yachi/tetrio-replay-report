# QA / tooling artefacts — never part of the repo
.playwright-cli/
.playwright/
**/shots/
__pycache__/
*.pyc

# archives of the raw replay drops
*.zip

# OS noise
.DS_Store
Thumbs.db

# local Dafny scratch
*.dfy.tmp
*.bak
# mutate-forecast.ts backs up the file it patches as <name>.mutbak and restores it afterwards.
# A crash or interrupt mid-sweep leaves that backup behind, and `*.bak` does not match it — so
# an unrestored copy of forecast.ts was one `git add` away from being committed as source.
*.mutbak

# derived simulation cache — regenerate with pipeline/sim/pairs.ts.
# The pattern must follow the CODE, not the sessions: the cache is written beside pairs.ts, so
# when the simulator moved to pipeline/sim a sessions-only pattern silently stopped matching and
# a 200 KB derived cache would have been committed as if it were source. The old pattern stays
# so an existing checkout's leftover cache is still ignored.
pipeline/sim/pairs-cache.json
sessions/*/sim/pairs-cache.json

# nix build symlink (the oracle derivation; the store path is the artifact, not this)
/result

# git worktrees for isolated feature work (superpowers:using-git-worktrees)
.worktrees/

# JS deps. `tools/triangle-oracle/` has its own package.json, and running its scripts from a
# git WORKTREE (which has no node_modules of its own) leaves a symlink here pointing at the main
# checkout's copy. Untracked and unignored, it sat one `git add -A` away from being committed as
# a symlink into a path that exists on exactly one machine.
#
# NO TRAILING SLASH, deliberately: `node_modules/` matches a directory, and git sees a symlink as
# a FILE — so the slashed form left the exact artefact described above still untracked-and-unignored.
node_modules
