// R020 [?] of the three 5-4 deciders, pinglamb won m2 and m3, yachi won m10
// 三場打到 5-4 嘅決勝場入面,pinglamb 攞咗 m2 同 m3,yachi 攞返 m10
lemma R020_of_the_three_5_4_deciders_pinglamb_won_m2_and_m3_yachi_won_m10()
  ensures (((m1_winner == "pinglamb") && ((m1_nrounds == 9) && (m2_winner == "pinglamb"))) && ((m2_nrounds == 9) && ((m9_winner == "yachi") && (m9_nrounds == 9))))
{
}

// R021 [?] in m10's decider yachi survived alive with higher PPS (1621) and APM (73680) than pinglamb
// m10 嘅決勝局,yachi 撑到最後 alive,PPS(1621)同 APM(73680)兩樣都爆過 pinglamb
lemma R021_in_m10_s_decider_yachi_survived_alive_with_higher_pps_1621_and_apm_736()
  ensures (((m9_r8_winner == "yachi") && ((m9_r8_yachi_alive == 1) && (m9_r8_yachi_pps == 1621))) && ((m9_r8_yachi_apm == 73680) && ((m9_r8_yachi_pps > m9_r8_pinglamb_pps) && (m9_r8_yachi_apm > m9_r8_pinglamb_apm))))
{
}

// R022 [?] in m3's decider pinglamb won with fewer pieces (40 vs 53) but a bigger spike (13 vs 5)
// m3 嘅決勝局,pinglamb 用少過 yachi 嘅方塊(40 vs 53)但係劈出更大 spike(13 vs 5)反殺
lemma R022_in_m3_s_decider_pinglamb_won_with_fewer_pieces_40_vs_53_but_a_bigger_s()
  ensures (((m2_r8_winner == "pinglamb") && (m2_r8_pinglamb_pieces == 40)) && ((m2_r8_yachi_pieces == 53) && ((m2_r8_pinglamb_maxspike == 13) && (m2_r8_yachi_maxspike == 5))))
{
}

// R023 [?] yachi's bounce-back rate after losing the previous round is higher than pinglamb's (18/32 vs 19/37)
