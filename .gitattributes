# .ttrm replays are single-line JSON blobs (one 65k+ char line).
# Diffing them is meaningless and they are not "our" source code.
*.ttrm linguist-vendored
*.ttrm -diff

# Generated Dafny carries the dataset as literals; don't let it skew language stats.
sessions/*/report/dafny/*.dfy linguist-generated
sessions/*/proof/dafny/*.dfy linguist-generated

# facts.json is machine-generated data, not hand-authored config.
sessions/**/facts*.json linguist-generated
sessions/**/facts*.json -diff

# Reports are generated single-file HTML.
sessions/**/report*.html linguist-generated
docs/*.html linguist-generated

# Generated SMT-LIB carries the dataset as definitions; same treatment as the Dafny.
sessions/*/report/claims.smt2 linguist-generated

# External forecast diagrams from Tetrisちゃんねる: binary evidence, not our source, no meaningful diff.
spec/fixtures/jp-forecast/*.jpg binary linguist-vendored
# The boards extracted from those images by pipeline/sim/extract_jp_forecast.py — machine data.
pipeline/sim/jp-forecast-boards.json linguist-generated -diff
# four.lol forecast boards, decoded from the committed fumen codes — machine data.
pipeline/sim/four-forecast-boards.json linguist-generated -diff
