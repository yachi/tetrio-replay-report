import RouteOrders.Hold

/-!
# A route node as data, and the counts the artefact publishes

`gen_data.py` transcribes `analysis/sdpcspin-orders.json` into `RouteOrders/Generated/` (gitignored,
regenerated by `check.sh`): per node its groups, its edges, `full_ok`, and — as the RIGHT-HAND SIDES
of the T3 theorems only — the artefact's counts and accepted bitsets. Everything on the left-hand
side is computed here, by `RouteOrders.Hold.acc`, the procedure T2 proves correct.
-/

namespace RouteOrders.NodeData
open RouteOrders.Hold

structure Node where
  name : String
  /-- each group's piece letter, in the artefact's group order -/
  pieces : List Char
  carried : List Bool
  /-- the artefact's `[subset, group]` edges -/
  edges : List (Nat × Nat)
  fullOk : Bool
  /-- the artefact's published figures (right-hand sides only) -/
  artEmpty : Nat
  artNext : Nat
  hexEmpty : String
  hexNext : String

/-- `accepts()`'s `dealt` map: a piece letter is the LAST non-carried group with that letter
    (`dealt.set` overwrites); the carried token is the first carried group. -/
def groupOf (n : Node) : Tok → Option Nat
  | .piece c =>
    ((List.range n.pieces.length).filter
      (fun i => n.pieces.getD i ' ' == c && !(n.carried.getD i false))).getLast?
  | .carried => (List.range n.pieces.length).find? (fun i => n.carried.getD i false)
  | .star => none

/-- an edge s → g of the DAG, and g not yet placed (`can` in `accepts()`) -/
def can (n : Node) (s g : Nat) : Bool := !(s.testBit g) && n.edges.contains (s, g)

def dagOf (n : Node) : Dag := { groupOf := groupOf n, can := can n, full := 2 ^ n.pieces.length - 1 }

/-- `allOrders()`: the 5040 dealt orders, lexicographic in the index of each piece in IOTSZJL. -/
def perms : Nat → List Char → List (List Char)
  | 0, _ => [[]]
  | n + 1, l => (List.range l.length).flatMap (fun i =>
      (perms n (l.eraseIdx i)).map (fun p => l.getD i ' ' :: p))

def allOrders : List (List Char) := perms 7 "IOTSZJL".toList

def countEmpty (n : Node) : Nat := (allOrders.filter (acceptsEmpty (dagOf n) n.fullOk)).length
def countNext (n : Node) : Nat := (allOrders.filter (acceptsNext (dagOf n) n.fullOk)).length

def hexDigit (v : Nat) : Char := "0123456789abcdef".toList.getD v '?'

/-- `bitsHex()`: bit j = order j, LSB first within each byte, as hex. -/
def bitsHex (bits : List Bool) : String :=
  let rec bytes : List Bool → List Nat
    | [] => []
    | b :: rest => (List.range 8).foldl
              (fun acc j => if (b :: rest).getD j false then acc + 2 ^ j else acc) 0
            :: bytes ((b :: rest).drop 8)
  termination_by l => l.length
  decreasing_by simp_all; omega
  String.ofList ((bytes bits).flatMap (fun b => [hexDigit (b / 16), hexDigit (b % 16)]))

def bitsEmpty (n : Node) : String := bitsHex (allOrders.map (acceptsEmpty (dagOf n) n.fullOk))
def bitsNext (n : Node) : String := bitsHex (allOrders.map (acceptsNext (dagOf n) n.fullOk))

/-- Every order is non-empty, so `count_empty_eq_next` applies to the artefact's order list. -/
theorem allOrders_ne_nil : ∀ q ∈ allOrders, q ≠ [] := by
  intro q hq
  simp only [allOrders, perms, List.mem_flatMap, List.mem_map] at hq
  obtain ⟨_, _, _, _, rfl⟩ := hq
  simp

/-- T4 applied to every node, kernel-checked (no native code): the two published counts agree. -/
theorem countEmpty_eq_countNext (n : Node) : countEmpty n = countNext n :=
  count_empty_eq_next (dagOf n) n.fullOk allOrders allOrders_ne_nil


/-! ## Axioms gate: no proof-hole axiom, no native-code axiom; only Lean's three standard axioms. -/

/-- info: 'RouteOrders.NodeData.countEmpty_eq_countNext' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms RouteOrders.NodeData.countEmpty_eq_countNext

end RouteOrders.NodeData
