  "quotes": [
    {
      "id": "intro",
      "verbatim": "ここでは、千鳥格子(Cut Cpoy)という、TSDを2回打つことができる中盤テンプレについて紹介していきます。",
      "typo_note": "the page writes 「Cut Cpoy」 here and 「Cut Copy」 in its title; quoted as written"
    },
    {
      "id": "h.basic",
      "verbatim": "基本形とラインの消し方"
    },
    {
      "id": "basic",
      "verbatim": "基本形は上図の通りです。"
    },
    {
      "id": "spin",
      "verbatim": "ここから、以下のようにを縦向きに入れてTSDを打つと、もう一度TSDを打てる形が残ります。",
      "icons": [
        "%T"
      ],
      "icons_note": "the page draws the T as a mino icon (<span class=\"mino tmino\">) in the gap 「ように_を縦向きに」; the text drops it. Not used as a caption. 縦向き (upright) against a T the boards draw flat: OUR READING is that the T drops in upright and turns into the flat slot; the window reads the drawing"
    },
    {
      "id": "h.build",
      "verbatim": "元地形からの組み方と特徴"
    },
    {
      "id": "build",
      "verbatim": "あまり自分で形を組んでいく形ではなく、穴がせり上がってきたときなどに組むことが多い。"
    },
    {
      "id": "h.hole",
      "verbatim": "T穴からの組み方"
    },
    {
      "id": "hole",
      "verbatim": "Tの形の穴がある場合、()を穴からずらして置くことで、千鳥格子を組むことができます。",
      "icons": [
        "%S",
        "%Z"
      ],
      "icons_note": "the page draws the two pieces as mino icons in the gaps 「場合、_(_)を」; the text drops them. Not used as a caption."
    },
    {
      "id": "z_later",
      "verbatim": "は1回目のT-spinを打った後に置いても構いません。",
      "icons": [
        "%Z"
      ],
      "icons_note": "the sentence opens with a %Z mino icon the text drops. Not used as a caption; it is the reason for the variant's not_expressed entry"
    },
    {
      "id": "h.col3",
      "verbatim": "3列目穴からの組み方"
    },
    {
      "id": "col3",
      "verbatim": "4列目でT-spinを組もうと思っていた時に、3列目穴がせり上がってきた場合、LST積みの要領で、を端2列に組むことで、千鳥格子を組むことができます。",
      "icons": [
        "%J",
        "%Z"
      ],
      "icons_note": "the page draws the two pieces as mino icons in the gap 「要領で、__を端2列に」; the text drops them. Not used as a caption."
    },
    {
      "id": "h.ref",
      "verbatim": "参考ページ"
    },
    {
      "id": "ref",
      "verbatim": "Cut copy - Hard Drop"
    }
  ],
