  "quotes": [
    {
      "id": "intro",
      "verbatim": "ここでは、BT砲(BT Cannon)と呼ばれる、TSD→TSTを打つことができる中盤テンプレについて紹介していきます。"
    },
    {
      "id": "name",
      "verbatim": "開幕BT砲と区別するために途中BT砲(途中BT)とも呼ばれます。"
    },
    {
      "id": "h.shape",
      "verbatim": "BT砲の形と消し方"
    },
    {
      "id": "shape",
      "verbatim": "BT砲の形は以下の通りで、TSDを打った後にTSTを打つことができます。"
    },
    {
      "id": "h.rotate",
      "verbatim": "回転方法"
    },
    {
      "id": "keys",
      "verbatim": "switchのキーで解説していきます。"
    },
    {
      "id": "rotate1",
      "verbatim": "屋根下に寄せてから右回転、右回転です。"
    },
    {
      "id": "rotate2",
      "verbatim": "初めに壁に寄せてから右回転です。"
    },
    {
      "id": "tst",
      "verbatim": "1つ目の%Tさえ入れることができれば、2つ目は普通のTSTです。"
    },
    {
      "id": "h.build",
      "verbatim": "BT砲の作り方"
    },
    {
      "id": "h.parapet",
      "verbatim": "欄干からの派生"
    },
    {
      "id": "parapet",
      "verbatim": "BT砲は開幕以外で組むことは中々難しいと思われがちですが、実は欄干を組む形からBT砲にすることができます。"
    },
    {
      "id": "caution",
      "verbatim": "ただし、途中DTと同様に下穴を塞いでしまうので注意してください。"
    },
    {
      "id": "h.parapet.make",
      "verbatim": "ここからこうすれば欄干"
    },
    {
      "id": "h.bt.make",
      "verbatim": "こうすると途中BT"
    },
    {
      "id": "h.72",
      "verbatim": "72積みからの派生"
    },
    {
      "id": "s72",
      "verbatim": "また、72積みから2列側の高さに応じて以下のように組むことで途中BT砲を打つことができます。"
    },
    {
      "id": "caution72",
      "verbatim": "ただし、途中DT同様に下穴を塞いでしまうので注意してください。"
    }
  ],
